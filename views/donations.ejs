<%- include("_loggedInHeader") -%>

<div class="pb-page">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/claimants/1">Members</a></li>
      <li class="breadcrumb-item active" aria-current="page">Donations</li>
    </ol>
  </nav>

  <!-- Toast notification -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="donationToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="bi bi-check-circle-fill me-2"></i>Donation saved successfully.
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>

  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Donations for <%= firstName %> <%= surname %></h1>
      <p class="pb-page-subtitle">Total giving: £<%= totalAmount %></p>
    </div>
    <div class="pb-page-actions d-print-none d-flex gap-2 flex-wrap">
      <button class="btn btn-primary btn-sm" id="openAddDonationBtn"><i class="bi bi-plus-circle me-1"></i>Add Donation</button>
      <a class="btn btn-secondary btn-sm" href="/generate-donor-pdf/<%= id %>"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
      <a class="btn btn-secondary btn-sm" href="/send-update-request/<%= id %>"><i class="bi bi-envelope me-1"></i>Request Update</a>
      <a class="btn btn-outline-secondary btn-sm" href="/claimants/1"><i class="bi bi-arrow-left me-1"></i>Return</a>
    </div>
  </div>

  <div class="pb-table-card">

    <!-- Desktop table -->
    <div class="d-none d-md-block table-responsive">
      <table class="table table-hover table-striped mb-0">
        <thead>
          <tr>
            <th>Date</th>
            <th>Amount</th>
            <th>Fund</th>
            <th>Method</th>
            <th>Gift Aid</th>
          </tr>
        </thead>
        <tbody>
          <% for (const payments of model) { %>
            <tr>
              <td class="text-nowrap"><%= payments.date ? new Date(payments.date).toLocaleDateString('en-GB') : '' %></td>
              <td class="fw-semibold">£<%= payments.amount %></td>
              <td><%= payments.fund %></td>
              <td><%= payments.method %></td>
              <td>
                <span class="badge <%= payments.gift_aid_status === 'Unclaimed' ? 'bg-warning text-dark' : payments.gift_aid_status === 'Claimed' ? 'bg-success' : 'bg-secondary' %>">
                  <%= payments.gift_aid_status %>
                </span>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div class="d-md-none p-2">
      <% if (model.length === 0) { %>
        <p class="text-muted text-center py-4 mb-0">No donations recorded yet.</p>
      <% } %>
      <% for (const payments of model) { %>
        <div class="card mb-2 border-0 shadow-sm">
          <div class="card-body py-2 px-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div>
                <div class="fw-semibold"><%= payments.fund %></div>
                <div class="text-muted" style="font-size:0.8rem;">
                  <%= payments.date ? new Date(payments.date).toLocaleDateString('en-GB') : '' %>
                  <% if (payments.method) { %>&middot; <%= payments.method %><% } %>
                </div>
              </div>
              <span class="fw-bold text-success" style="font-size:1rem; white-space:nowrap;">£<%= payments.amount %></span>
            </div>
            <span class="badge <%= payments.gift_aid_status === 'Unclaimed' ? 'bg-warning text-dark' : payments.gift_aid_status === 'Claimed' ? 'bg-success' : 'bg-secondary' %>" style="font-size:0.7rem;">
              <%= payments.gift_aid_status %>
            </span>
          </div>
        </div>
      <% } %>
    </div>

  </div>
</div>

<!-- ── Add Donation Modal ──────────────────────────────────────── -->
<div class="modal fade" id="addDonationModal" tabindex="-1" aria-labelledby="addDonationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <!-- Header -->
      <div class="modal-header pb-modal-header">
        <div>
          <h5 class="modal-title mb-0" id="addDonationModalLabel">
            <i class="bi bi-wallet2 me-2"></i>Add Donation
          </h5>
          <small class="text-muted">for <%= firstName %> <%= surname %></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <form id="donationModalForm" novalidate>
          <input type="hidden" id="modal_member_id" name="member_id" value="<%= id %>">
          <input type="hidden" id="modal_first_name" name="first_name" value="<%= firstName %>">
          <input type="hidden" id="modal_surname" name="surname" value="<%= surname %>">

          <div class="row g-3 mb-3">
            <div class="col-sm-4">
              <label class="form-label" for="modal_amount">Amount (£)</label>
              <input type="number" step="0.01" min="0" class="form-control" name="amount" id="modal_amount" required>
              <div class="invalid-feedback">Please enter an amount.</div>
            </div>
            <div class="col-sm-4">
              <label class="form-label" for="modal_date">Date</label>
              <input type="date" class="form-control" name="date" id="modal_date" required>
              <div class="invalid-feedback">Please select a date.</div>
            </div>
            <div class="col-sm-4">
              <label class="form-label" for="modal_gift_aid">Gift Aid Status</label>
              <select class="form-select" name="gift_aid_status" id="modal_gift_aid">
                <option value="Unclaimed" selected>Unclaimed</option>
                <option value="Claimed">Claimed</option>
                <option value="N/A">N/A</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="modal_fund">Fund</label>
            <select required class="form-select" name="fund" id="modal_fund">
              <option value="">— Select fund —</option>
              <% donationTypes.forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
            <div class="invalid-feedback">Please select a fund.</div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="modal_notes">Notes</label>
            <input class="form-control" name="notes" id="modal_notes" placeholder="Optional notes…">
          </div>

          <!-- Error area -->
          <div id="modalError" class="alert alert-danger d-none" role="alert"></div>
        </form>
      </div>

      <!-- Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="submitDonationBtn">
          <span id="submitBtnSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-check-lg me-1" id="submitBtnIcon"></i>Save Donation
        </button>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal     = document.getElementById('addDonationModal');
  const bsModal   = new bootstrap.Modal(modal);
  const form      = document.getElementById('donationModalForm');
  const submitBtn = document.getElementById('submitDonationBtn');
  const spinner   = document.getElementById('submitBtnSpinner');
  const submitIcon = document.getElementById('submitBtnIcon');
  const errorBox  = document.getElementById('modalError');

  document.getElementById('openAddDonationBtn').addEventListener('click', function () {
    form.reset();
    form.classList.remove('was-validated');
    errorBox.classList.add('d-none');
    // Set today's date as default
    document.getElementById('modal_date').value = new Date().toISOString().slice(0, 10);
    bsModal.show();
  });

  submitBtn.addEventListener('click', async () => {
    form.classList.add('was-validated');
    if (!form.checkValidity()) return;

    const payload = {
      member_id:       document.getElementById('modal_member_id').value || null,
      first_name:      document.getElementById('modal_first_name').value.trim(),
      surname:         document.getElementById('modal_surname').value.trim(),
      amount:          document.getElementById('modal_amount').value,
      date:            document.getElementById('modal_date').value,
      fund:            document.getElementById('modal_fund').value,
      notes:           document.getElementById('modal_notes').value.trim(),
      gift_aid_status: document.getElementById('modal_gift_aid').value,
    };

    spinner.classList.remove('d-none');
    submitIcon.classList.add('d-none');
    submitBtn.disabled = true;
    errorBox.classList.add('d-none');

    try {
      const res = await fetch('/api/donations/modal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (data.success) {
        bsModal.hide();
        const toast = new bootstrap.Toast(document.getElementById('donationToast'), { delay: 3500 });
        toast.show();
        // Reload to reflect new donation in table
        setTimeout(() => location.reload(), 3600);
      } else {
        errorBox.textContent = data.error || 'Failed to save donation.';
        errorBox.classList.remove('d-none');
      }
    } catch {
      errorBox.textContent = 'Network error — please try again.';
      errorBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      submitIcon.classList.remove('d-none');
      submitBtn.disabled = false;
    }
  });
});
</script>

<%- include("_loggedInFooter") -%>
