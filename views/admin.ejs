            <label class="form-label" for="tx_export">Export</label>
            <select class="form-select" name="export" id="tx_export" required>
              <option value="everything">Everything</option>
              <option value="allPaidIn">All Paid In</option>
              <option value="allPaidOut">All Paid Out</option>
              <option value="allPaidOutOver£2000">All Paid Out Over £2000</option>
              <% (transactionTypes || []).forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label" for="tx_start">Date From</label>
              <input type="date" class="form-control" id="tx_start" name="start_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
            <div class="col-6">
              <label class="form-label" for="tx_end">Date To</label>
              <input type="date" class="form-control" id="tx_end" name="end_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Action</label>
            <div class="d-flex gap-3">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tx_action" id="tx_action_download" value="download" checked>
                <label class="form-check-label" for="tx_action_download"><i class="bi bi-download me-1"></i>Download</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tx_action" id="tx_action_email" value="email">
                <label class="form-check-label" for="tx_action_email"><i class="bi bi-envelope me-1"></i>Email</label>
              </div>
            </div>
          </div>

          <div class="mb-3 d-none" id="tx_email_row">
            <label class="form-label" for="tx_email">Send To Email</label>
            <input type="email" class="form-control" id="tx_email" placeholder="recipient@example.com">
          </div>

          <div id="txError" class="alert alert-danger d-none" role="alert"></div>
          <div id="txSuccess" class="alert alert-success d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="txSubmitBtn">
          <span id="txSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-file-earmark-pdf me-1" id="txIcon"></i>Generate
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Export Donations Modal ──────────────────────────────────── -->
<div class="modal fade" id="donationsModal" tabindex="-1" aria-labelledby="donationsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="donationsModalLabel">
          <i class="bi bi-file-earmark-pdf me-2"></i>Export Donations
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="donationsForm" novalidate>

          <div class="mb-3">
            <label class="form-label" for="dn_fund">Fund Type</label>
            <select class="form-select" name="fund" id="dn_fund">
              <option value="all">All Types</option>
              <% (donationTypes || []).forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label" for="dn_start">Date From</label>
              <input type="date" class="form-control" id="dn_start" name="start_date">
            </div>
            <div class="col-6">
              <label class="form-label" for="dn_end">Date To</label>
              <input type="date" class="form-control" id="dn_end" name="end_date">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Action</label>
            <div class="d-flex gap-3">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="dn_action" id="dn_action_download" value="download" checked>
                <label class="form-check-label" for="dn_action_download"><i class="bi bi-download me-1"></i>Download</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="dn_action" id="dn_action_email" value="email">
                <label class="form-check-label" for="dn_action_email"><i class="bi bi-envelope me-1"></i>Email</label>
              </div>
            </div>
          </div>

          <div class="mb-3 d-none" id="dn_email_row">
            <label class="form-label" for="dn_email">Send To Email</label>
            <input type="email" class="form-control" id="dn_email" placeholder="recipient@example.com">
          </div>

          <div id="dnError" class="alert alert-danger d-none" role="alert"></div>
          <div id="dnSuccess" class="alert alert-success d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="dnSubmitBtn">
          <span id="dnSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-file-earmark-pdf me-1" id="dnIcon"></i>Generate
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  async function fetchPdf(url, payload, filename, { spinner, icon, errorBox, successBox, submitBtn }) {
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    submitBtn.disabled = true;
    errorBox.classList.add('d-none');
    if (successBox) successBox.classList.add('d-none');
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const contentType = res.headers.get('Content-Type') || '';
      const isDownload  = res.ok && !contentType.includes('application/json');
      if (isDownload) {
        // Prefer server-suggested filename when available
        const disp = res.headers.get('Content-Disposition') || '';
        const match = /filename="?([^"]+)"?/.exec(disp);
        const outName = match ? match[1] : filename;
        const blob = await res.blob();
        const objectUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = objectUrl;
        a.download = outName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(objectUrl);
        return;
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Server error');
      if (data.success) {
        if (successBox) {
          successBox.textContent = data.message || 'Sent successfully.';
          successBox.classList.remove('d-none');
        }
        return;
      }
      throw new Error(data.error || 'Unexpected response.');
    } catch (err) {
      errorBox.textContent = err.message || 'Failed to generate PDF.';
      errorBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      icon.classList.remove('d-none');
      submitBtn.disabled = false;
    }
  }

  function wireActionToggle(radioName, emailRowId) {
    const row = document.getElementById(emailRowId);
    document.querySelectorAll(`input[name="${radioName}"]`).forEach(r => {
      r.addEventListener('change', function () {
        if (this.value === 'email') row.classList.remove('d-none');
        else                        row.classList.add('d-none');
      });
    });
  }
  wireActionToggle('tot_action', 'tot_email_row');
  wireActionToggle('tx_action',  'tx_email_row');
  wireActionToggle('dn_action',  'dn_email_row');

  // ── Totals modal ───────────────────────────────────────────────
  const totalsModal   = new bootstrap.Modal(document.getElementById('totalsModal'));
  const totalsForm    = document.getElementById('totalsForm');
  const totSubmit     = document.getElementById('totSubmitBtn');
  const totSpinner    = document.getElementById('totSpinner');
  const totIcon       = document.getElementById('totIcon');
  const totError      = document.getElementById('totError');
  const totSuccess    = document.getElementById('totSuccess');

  document.getElementById('openTotalsModal').addEventListener('click', () => {
    totalsForm.reset();
    totalsForm.classList.remove('was-validated');
    totError.classList.add('d-none');
    totSuccess.classList.add('d-none');
    document.getElementById('tot_action_download').checked = true;
    document.getElementById('tot_email_row').classList.add('d-none');
    totalsModal.show();
  });

  totSubmit.addEventListener('click', async () => {
    totalsForm.classList.add('was-validated');
    const start  = document.getElementById('tot_start').value;
    const end    = document.getElementById('tot_end').value;
    const action = document.querySelector('input[name="tot_action"]:checked').value;
    const email  = document.getElementById('tot_email').value.trim();
    if (!start || !end) return;
    if (action === 'email' && !email) {
      totError.textContent = 'Please enter an email address.';
      totError.classList.remove('d-none');
      return;
    }
    await fetchPdf(
      '/export-totals',
      { start_date: start, end_date: end, action, email },
      `totals_export_${start}_to_${end}.pdf`,
      { spinner: totSpinner, icon: totIcon, errorBox: totError, successBox: totSuccess, submitBtn: totSubmit },
    );
  });

  // ── Transactions modal ─────────────────────────────────────────
  const txModal   = new bootstrap.Modal(document.getElementById('transactionModal'));
  const txForm    = document.getElementById('transactionForm');
  const txSubmit  = document.getElementById('txSubmitBtn');
  const txSpinner = document.getElementById('txSpinner');
  const txIcon    = document.getElementById('txIcon');
  const txError   = document.getElementById('txError');
  const txSuccess = document.getElementById('txSuccess');

  document.getElementById('openTransactionModal').addEventListener('click', () => {
    txForm.reset();
    txForm.classList.remove('was-validated');
    txError.classList.add('d-none');
    txSuccess.classList.add('d-none');
    document.getElementById('tx_action_download').checked = true;
    document.getElementById('tx_email_row').classList.add('d-none');
    txModal.show();
  });

  txSubmit.addEventListener('click', async () => {
    txForm.classList.add('was-validated');
    if (!txForm.checkValidity()) return;
    const start  = document.getElementById('tx_start').value;
    const end    = document.getElementById('tx_end').value;
    const exp    = document.getElementById('tx_export').value;
    const action = document.querySelector('input[name="tx_action"]:checked').value;
    const email  = document.getElementById('tx_email').value.trim();
    if (action === 'email' && !email) {
      txError.textContent = 'Please enter an email address.';
      txError.classList.remove('d-none');
      return;
    }
    await fetchPdf(
      '/generate-transaction-pdf',
      { start_date: start, end_date: end, export: exp, action, email_to: email },
      `transactions_${start}_to_${end}.pdf`,
      { spinner: txSpinner, icon: txIcon, errorBox: txError, successBox: txSuccess, submitBtn: txSubmit },
    );
  });

  // ── Donations modal ────────────────────────────────────────────
  const dnModal   = new bootstrap.Modal(document.getElementById('donationsModal'));
  const dnForm    = document.getElementById('donationsForm');
  const dnSubmit  = document.getElementById('dnSubmitBtn');
  const dnSpinner = document.getElementById('dnSpinner');
  const dnIcon    = document.getElementById('dnIcon');
  const dnError   = document.getElementById('dnError');
  const dnSuccess = document.getElementById('dnSuccess');

  document.getElementById('openDonationsModal').addEventListener('click', () => {
    dnForm.reset();
    dnError.classList.add('d-none');
    dnSuccess.classList.add('d-none');
    document.getElementById('dn_action_download').checked = true;
    document.getElementById('dn_email_row').classList.add('d-none');
    dnModal.show();
  });

  dnSubmit.addEventListener('click', async () => {
    const fund   = document.getElementById('dn_fund').value;
    const start  = document.getElementById('dn_start').value;
    const end    = document.getElementById('dn_end').value;
    const action = document.querySelector('input[name="dn_action"]:checked').value;
    const email  = document.getElementById('dn_email').value.trim();
    const date   = new Date().toISOString().slice(0, 10);
    const slug   = fund && fund !== 'all' ? `_${fund.replace(/[^a-z0-9]/gi, '_')}` : '';
    if (action === 'email' && !email) {
      dnError.textContent = 'Please enter an email address.';
      dnError.classList.remove('d-none');
      return;
    }
    await fetchPdf(
      '/export-donations',
      { fund, start_date: start || null, end_date: end || null, action, email_to: email },
      `donations_export${slug}_${date}.pdf`,
      { spinner: dnSpinner, icon: dnIcon, errorBox: dnError, successBox: dnSuccess, submitBtn: dnSubmit },
    );
  });

});
</script>

<!-- ── Gift Aid Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="giftAidModal" tabindex="-1" aria-labelledby="giftAidModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="giftAidModalLabel"><i class="bi bi-file-earmark-check me-2"></i>Claim Gift Aid</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="giftAidLoading" class="text-center py-3">
          <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading summary...
        </div>
        <div id="giftAidSummary" class="d-none">
          <table class="table table-sm table-borderless mb-0">
            <thead class="table-light">
              <tr><th>Category</th><th class="text-center">Count</th><th class="text-end">Amount</th></tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-muted">Unclaimed donations</td>
                <td class="text-center" id="gaDonationCount">—</td>
                <td class="fw-semibold text-end" id="gaDonationTotal">—</td>
              </tr>
              <tr class="table-success">
                <td class="fw-semibold">Receivable from HMRC</td>
                <td></td>
                <td class="fw-bold text-end" id="gaReceivable">—</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Review table (hidden until user clicks Review) -->
        <div id="gaPreviewSection" class="d-none mt-3">
          <h6 class="mb-2">Review Records</h6>
          <div id="gaPreviewLoading" class="text-center py-2 d-none">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading records...
          </div>
          <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-sm table-striped table-bordered mb-0" style="font-size: 0.85rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Title</th>
                  <th>First Name</th>
                  <th>Last Name</th>
                  <th>House No.</th>
                  <th>Postcode</th>
                  <th class="text-end">Amount</th>
                  <th>Date (DD/MM/YY)</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="gaPreviewBody"></tbody>
            </table>
          </div>
          <p class="text-muted mt-2 mb-0" style="font-size:0.8rem;">
            Rows highlighted in <span class="badge bg-warning text-dark">yellow</span> have missing data and
            <strong>will not be included</strong> in the export. You can fill in the missing fields and click Save to fix them.
            Clicking <strong>Export &amp; Mark Claimed</strong> will download the CSV and mark only the complete records as claimed.
          </p>
        </div>

        <div id="giftAidNone" class="d-none text-muted text-center py-3">No unclaimed donations found.</div>
        <div id="giftAidError" class="alert alert-danger d-none mt-2" role="alert"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary d-none" id="gaReviewBtn">
          <i class="bi bi-eye me-1"></i>Review Records
        </button>
        <button type="button" class="btn btn-success d-none" id="gaExportBtn">
          <span id="gaSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-download me-1" id="gaIcon"></i>Export &amp; Mark Claimed
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Gift Aid Claim History Modal ────────────────────────────── -->
<div class="modal fade" id="giftAidHistoryModal" tabindex="-1" aria-labelledby="giftAidHistoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="giftAidHistoryModalLabel"><i class="bi bi-clock-history me-2"></i>Gift Aid Claim History</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="gahLoading" class="text-center py-3">
          <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading claim history...
        </div>
        <div id="gahEmpty" class="d-none text-muted text-center py-3">No gift aid claims have been made yet.</div>
        <div id="gahError" class="alert alert-danger d-none" role="alert"></div>
        <div class="table-responsive d-none" id="gahTableWrap" style="max-height: 450px; overflow-y: auto;">
          <table class="table table-sm table-striped mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th>Date</th>
                <th>Claimed By</th>
                <th class="text-center">Records</th>
                <th class="text-end">Donations Total</th>
                <th class="text-end">Receivable</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="gahBody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ── Invite User Modal ────────────────────────────────────────── -->
<div class="modal fade" id="inviteModal" tabindex="-1" aria-labelledby="inviteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="inviteModalLabel"><i class="bi bi-envelope-plus me-2"></i>Invite User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/charity/invite" method="post">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input required type="email" name="email" class="form-control" placeholder="user@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Role</label>
            <select required name="role" class="form-select">
              <option value="user">User</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Send Invite</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ── Resend Invite Modal ──────────────────────────────────────── -->
<div class="modal fade" id="resendInviteModal" tabindex="-1" aria-labelledby="resendInviteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="resendInviteModalLabel"><i class="bi bi-envelope-arrow-up me-2"></i>Resend Invite</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p style="font-size:0.85rem;color:var(--pb-gray-400);">Enter the email address of a pending invite to resend it. A new 48-hour token will be generated.</p>
        <div class="mb-3">
          <label class="form-label">Email Address</label>
          <input required type="email" id="resendEmail" class="form-control" placeholder="user@example.com">
        </div>
        <div id="resendError" class="alert alert-danger d-none" role="alert"></div>
        <div id="resendSuccess" class="alert alert-success d-none" role="alert"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="resendSubmitBtn">
          <span id="resendSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-send me-1" id="resendIcon"></i>Resend
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Create Charity Modal (super admin only) ──────────────────── -->
<div class="modal fade" id="createCharityModal" tabindex="-1" aria-labelledby="createCharityModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="createCharityModalLabel"><i class="bi bi-building-add me-2"></i>Create Charity</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/charities" method="post">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Charity Name</label>
            <input required type="text" name="name" class="form-control" placeholder="NewLife Church Sunderland">
          </div>
          <div class="mb-3">
            <label class="form-label">Slug <small class="text-muted">(unique, lowercase, hyphens only)</small></label>
            <input required type="text" name="slug" class="form-control" placeholder="newlife-sunderland" pattern="[a-z0-9\-]+" title="Lowercase letters, numbers and hyphens only">
          </div>
          <div class="mb-3">
            <label class="form-label">Charity Contact Email <small class="text-muted">(optional)</small></label>
            <input type="email" name="email" class="form-control" placeholder="info@charity.org">
          </div>
          <div class="mb-3">
            <label class="form-label">First Admin Email</label>
            <input required type="email" name="admin_email" class="form-control" placeholder="admin@charity.org">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-building-add me-1"></i>Create &amp; Send Invite</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // ── Gift Aid modal ─────────────────────────────────────────────
  const giftAidModal = new bootstrap.Modal(document.getElementById('giftAidModal'));

  document.getElementById('openGiftAidModal').addEventListener('click', async () => {
    document.getElementById('giftAidLoading').classList.remove('d-none');
    document.getElementById('giftAidSummary').classList.add('d-none');
    document.getElementById('giftAidNone').classList.add('d-none');
    document.getElementById('giftAidError').classList.add('d-none');
    document.getElementById('gaExportBtn').classList.add('d-none');
    document.getElementById('gaReviewBtn').classList.add('d-none');
    document.getElementById('gaPreviewSection').classList.add('d-none');
    document.getElementById('gaPreviewBody').innerHTML = '';
    giftAidModal.show();

    try {
      const res  = await fetch('/api/giftaid-summary');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Server error');

      document.getElementById('giftAidLoading').classList.add('d-none');

      const fmt = v => '£' + parseFloat(v).toLocaleString('en-GB', { minimumFractionDigits: 2 });
      if (data.donationCount === 0) {
        document.getElementById('giftAidNone').classList.remove('d-none');
      } else {
        document.getElementById('gaDonationCount').textContent = data.donationCount;
        document.getElementById('gaDonationTotal').textContent = fmt(data.donationTotal);
        document.getElementById('gaReceivable').textContent    = fmt(data.receivable);
        document.getElementById('giftAidSummary').classList.remove('d-none');
        document.getElementById('gaReviewBtn').classList.remove('d-none');
      }
    } catch (err) {
      document.getElementById('giftAidLoading').classList.add('d-none');
      document.getElementById('giftAidError').textContent = err.message || 'Could not load summary.';
      document.getElementById('giftAidError').classList.remove('d-none');
    }
  });

  // Format date as DD/MM/YY
  function hmrcDateFmt(val) {
    if (!val) return '';
    const d = new Date(val);
    if (isNaN(d)) return val;
    const dd = String(d.getUTCDate()).padStart(2, '0');
    const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
    const yy = String(d.getUTCFullYear()).slice(-2);
    return dd + '/' + mm + '/' + yy;
  }

  // Format postcode: uppercase, space before last 3
  function fmtPostcode(pc) {
    if (!pc) return '';
    const s = pc.replace(/\s+/g, '').toUpperCase();
    if (s.length < 5 || s.length > 7) return pc.trim().toUpperCase();
    return s.slice(0, -3) + ' ' + s.slice(-3);
  }

  document.getElementById('gaReviewBtn').addEventListener('click', async () => {
    const reviewBtn = document.getElementById('gaReviewBtn');
    const section   = document.getElementById('gaPreviewSection');
    const loading   = document.getElementById('gaPreviewLoading');
    const tbody     = document.getElementById('gaPreviewBody');
    const errBox    = document.getElementById('giftAidError');

    reviewBtn.disabled = true;
    section.classList.remove('d-none');
    loading.classList.remove('d-none');
    tbody.innerHTML = '';

    try {
      const res  = await fetch('/api/giftaid-preview');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Server error');

      loading.classList.add('d-none');

      // Group by member_id so we only show one editable row per member
      const seen = new Set();
      let completeCount = 0;
      data.rows.forEach(r => {
        const pc = fmtPostcode(r.postcode);
        const hasIssue = !pc || !r.house_name_or_number || !r.first_name || !r.last_name;
        if (!hasIssue) completeCount++;
        const mid = r.member_id;
        const editable = hasIssue && !seen.has(mid);
        if (hasIssue) seen.add(mid);

        const tr = document.createElement('tr');
        tr.dataset.memberId = mid;
        if (hasIssue) tr.classList.add('table-warning');

        const cell = (val, field) => {
          if (!editable || val) return '<td>' + (val || '') + '</td>';
          return '<td><input type="text" class="form-control form-control-sm ga-edit" data-field="' + field + '" value="" placeholder="Required" style="min-width:80px"></td>';
        };

        tr.innerHTML =
          cell(r.title || '', 'title') +
          cell(r.first_name, 'first_name') +
          cell(r.last_name, 'surname') +
          cell(r.house_name_or_number, 'house_number') +
          cell(pc, 'postcode') +
          '<td class="text-end">' + (parseFloat(r.amount) || 0).toFixed(2) + '</td>' +
          '<td>' + hmrcDateFmt(r.date) + '</td>' +
          (editable
            ? '<td><button type="button" class="btn btn-sm btn-outline-primary ga-save-btn">Save</button></td>'
            : '<td></td>');

        tbody.appendChild(tr);
      });

      // Wire up save buttons
      tbody.querySelectorAll('.ga-save-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
          const row = this.closest('tr');
          const memberId = row.dataset.memberId;
          const payload = {};
          row.querySelectorAll('.ga-edit').forEach(input => {
            payload[input.dataset.field] = input.value.trim();
          });
          this.disabled = true;
          this.textContent = 'Saving…';
          try {
            const res = await fetch('/api/member/' + memberId, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Save failed');
            // Replace inputs with saved values and remove warning
            row.querySelectorAll('.ga-edit').forEach(input => {
              const td = input.parentElement;
              let val = input.value.trim();
              if (input.dataset.field === 'postcode') val = fmtPostcode(val);
              td.textContent = val;
            });
            this.parentElement.innerHTML = '<i class="bi bi-check-lg text-success"></i>';
            row.classList.remove('table-warning');
            // Update all other rows for the same member
            tbody.querySelectorAll('tr[data-member-id="' + memberId + '"]').forEach(r => {
              r.classList.remove('table-warning');
            });
            // Re-enable export button and refresh its count
            const warned = tbody.querySelectorAll('tr.table-warning').length;
            const total  = tbody.querySelectorAll('tr').length;
            const complete = total - warned;
            const exportBtn = document.getElementById('gaExportBtn');
            if (complete > 0) {
              exportBtn.disabled = false;
              exportBtn.title = '';
              exportBtn.innerHTML = '<span id="gaSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>'
                + '<i class="bi bi-download me-1" id="gaIcon"></i>Export &amp; Mark Claimed ('
                + complete + ' record' + (complete === 1 ? '' : 's') + ')';
            }
          } catch (err) {
            this.textContent = 'Retry';
            this.disabled = false;
            errBox.textContent = err.message || 'Save failed.';
            errBox.classList.remove('d-none');
          }
        });
      });

      reviewBtn.classList.add('d-none');
      const exportBtn = document.getElementById('gaExportBtn');
      exportBtn.classList.remove('d-none');
      if (completeCount === 0) {
        exportBtn.disabled = true;
        exportBtn.title = 'Fix at least one row to enable export';
      } else {
        exportBtn.disabled = false;
        exportBtn.title = '';
        exportBtn.innerHTML = '<span id="gaSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>'
          + '<i class="bi bi-download me-1" id="gaIcon"></i>Export &amp; Mark Claimed ('
          + completeCount + ' record' + (completeCount === 1 ? '' : 's') + ')';
      }
    } catch (err) {
      loading.classList.add('d-none');
      errBox.textContent = err.message || 'Could not load preview.';
      errBox.classList.remove('d-none');
      reviewBtn.disabled = false;
    }
  });

  document.getElementById('gaExportBtn').addEventListener('click', async () => {
    const spinner = document.getElementById('gaSpinner');
    const icon    = document.getElementById('gaIcon');
    const errBox  = document.getElementById('giftAidError');
    const btn     = document.getElementById('gaExportBtn');

    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    btn.disabled = true;
    errBox.classList.add('d-none');

    try {
      const res = await fetch('/export-giftaid-claims', { method: 'POST' });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Export failed.');
      }
      const blob = await res.blob();
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = 'giftaid_claim.csv';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      giftAidModal.hide();
    } catch (err) {
      errBox.textContent = err.message || 'Export failed.';
      errBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      icon.classList.remove('d-none');
      btn.disabled = false;
    }
  });

  // ── Gift Aid Claim History modal ──────────────────────────────
  const giftAidHistoryModal = new bootstrap.Modal(document.getElementById('giftAidHistoryModal'));

  document.getElementById('openGiftAidHistoryModal')?.addEventListener('click', async () => {
    const loading = document.getElementById('gahLoading');
    const empty   = document.getElementById('gahEmpty');
    const errBox  = document.getElementById('gahError');
    const wrap    = document.getElementById('gahTableWrap');
    const tbody   = document.getElementById('gahBody');

    loading.classList.remove('d-none');
    empty.classList.add('d-none');
    errBox.classList.add('d-none');
    wrap.classList.add('d-none');
    tbody.innerHTML = '';
    giftAidHistoryModal.show();

    try {
      const res  = await fetch('/api/giftaid-claims');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Server error');

      loading.classList.add('d-none');
      if (!data.claims || data.claims.length === 0) {
        empty.classList.remove('d-none');
        return;
      }

      const fmtMoney = v => '£' + parseFloat(v).toLocaleString('en-GB', { minimumFractionDigits: 2 });
      const fmtDateTime = s => {
        const d = new Date(s);
        const dd = String(d.getDate()).padStart(2, '0');
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const yyyy = d.getFullYear();
        const hh = String(d.getHours()).padStart(2, '0');
        const mi = String(d.getMinutes()).padStart(2, '0');
        return `${dd}/${mm}/${yyyy} ${hh}:${mi}`;
      };

      data.claims.forEach(c => {
        const receivable = (parseFloat(c.total_amount) * 0.25).toFixed(2);
        const tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' + fmtDateTime(c.claimed_at) + '</td>' +
          '<td>' + (c.claimed_by || '—') + '</td>' +
          '<td class="text-center">' + c.record_count + '</td>' +
          '<td class="text-end">' + fmtMoney(c.total_amount) + '</td>' +
          '<td class="text-end">' + fmtMoney(receivable) + '</td>' +
          '<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/api/giftaid-claims/' + c.id + '/csv"><i class="bi bi-download me-1"></i>CSV</a></td>';
        tbody.appendChild(tr);
      });
      wrap.classList.remove('d-none');
    } catch (err) {
      loading.classList.add('d-none');
      errBox.textContent = err.message || 'Could not load claim history.';
      errBox.classList.remove('d-none');
    }
  });

  document.getElementById('openInviteModal')?.addEventListener('click', () => {
    new bootstrap.Modal(document.getElementById('inviteModal')).show();
  });

  document.getElementById('openCreateCharityModal')?.addEventListener('click', () => {
    new bootstrap.Modal(document.getElementById('createCharityModal')).show();
  });

  // Resend invite
  const resendModal = new bootstrap.Modal(document.getElementById('resendInviteModal'));
  document.getElementById('openResendInviteModal').addEventListener('click', () => {
    document.getElementById('resendEmail').value = '';
    document.getElementById('resendError').classList.add('d-none');
    document.getElementById('resendSuccess').classList.add('d-none');
    resendModal.show();
  });

  document.getElementById('resendSubmitBtn').addEventListener('click', async () => {
    const email   = document.getElementById('resendEmail').value.trim();
    const errBox  = document.getElementById('resendError');
    const okBox   = document.getElementById('resendSuccess');
    const spinner = document.getElementById('resendSpinner');
    const icon    = document.getElementById('resendIcon');
    const btn     = document.getElementById('resendSubmitBtn');

    errBox.classList.add('d-none');
    okBox.classList.add('d-none');
    if (!email) { errBox.textContent = 'Please enter an email address.'; errBox.classList.remove('d-none'); return; }

    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    btn.disabled = true;

    // Super admins use the global endpoint; charity admins use the scoped one
    const endpoint = <%= isSuperAdmin ? 'true' : 'false' %> ? '/admin/invite/resend' : '/charity/invite/resend';

    try {
      const res  = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Server error');
      okBox.textContent = `Invite resent to ${email}.`;
      okBox.classList.remove('d-none');
    } catch (err) {
      errBox.textContent = err.message || 'Failed to resend invite.';
      errBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      icon.classList.remove('d-none');
      btn.disabled = false;
    }
  });
});
</script>

<%- include("_loggedInFooter") -%>
