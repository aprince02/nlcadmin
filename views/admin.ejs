<%- include("_loggedInHeader") -%>

<div class="pb-page">

  <div class="pb-admin-layout">

    <!-- ── Sidebar — help & resources ──────────────────────────── -->
    <aside class="pb-admin-sidebar">
      <div class="pb-admin-sidebar-brand">
        <div class="icon"><i class="bi bi-life-preserver"></i></div>
        <div>
          <div class="title">Help &amp; Support</div>
          <div class="subtitle">Resources and contact</div>
        </div>
      </div>

      <a class="pb-admin-sidebar-item" href="/docs"><i class="bi bi-book"></i>Documentation</a>
      <a class="pb-admin-sidebar-item" href="mailto:support@probooksaccounting.co.uk"><i class="bi bi-envelope"></i>Contact Support</a>
    </aside>

    <!-- ── Main content ────────────────────────────────────────── -->
    <div>

      <div class="pb-admin-eyebrow mb-2">
        <i class="bi bi-shield-check"></i>Administrative Suite
      </div>
      <h1 class="pb-page-title mb-1">Admin Console</h1>
      <p class="pb-page-subtitle mb-4">Manage system-wide configurations, financial reporting, and user permissions from a centralized control panel.</p>

      <!-- ── Stat cards ────────────────────────────────────────── -->
      <% if (stats) { %>
        <div class="pb-stat-grid">
          <div class="pb-stat-card">
            <div class="pb-stat-label">Unclaimed Donations</div>
            <div class="pb-stat-value"><%= stats.unclaimed.count %></div>
            <div class="pb-stat-sub">£<%= parseFloat(stats.unclaimed.total).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ready to claim</div>
          </div>
          <div class="pb-stat-card">
            <div class="pb-stat-label">This Month's Donations</div>
            <div class="pb-stat-value">£<%= parseFloat(stats.thisMonth.total).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
            <div class="pb-stat-sub"><%= stats.thisMonth.count %> donation<%= stats.thisMonth.count === 1 ? '' : 's' %> received</div>
          </div>
          <div class="pb-stat-card">
            <div class="pb-stat-label">Last Gift Aid Claim</div>
            <% if (stats.lastClaim) { %>
              <div class="pb-stat-value">£<%= (parseFloat(stats.lastClaim.total_amount) * 0.25).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
              <div class="pb-stat-sub">Claimed <%= new Date(stats.lastClaim.claimed_at).toLocaleDateString('en-GB') %> · <%= stats.lastClaim.record_count %> record<%= stats.lastClaim.record_count === 1 ? '' : 's' %></div>
            <% } else { %>
              <div class="pb-stat-value text-muted">—</div>
              <div class="pb-stat-sub">No claims yet</div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- ── Action cards ──────────────────────────────────────── -->
      <div class="pb-admin-grid">

        <!-- Reports & Exports -->
        <div class="pb-admin-card" id="reports">
          <div class="pb-admin-card-head">
            <div class="title"><i class="bi bi-bar-chart-fill"></i>Reports &amp; Exports</div>
            <span class="count-pill">5 Actions</span>
          </div>
          <div class="pb-admin-card-body">
            <button type="button" class="pb-admin-link" id="openTransactionModal">Export Transactions<i class="bi bi-chevron-right"></i></button>
            <button type="button" class="pb-admin-link" id="openDonationsModal">Export Donations<i class="bi bi-chevron-right"></i></button>
            <button type="button" class="pb-admin-link" id="openTotalsModal">Export Totals<i class="bi bi-chevron-right"></i></button>
            <button type="button" class="pb-admin-link" id="openGiftAidModal">Claim Gift Aid<i class="bi bi-chevron-right"></i></button>
            <button type="button" class="pb-admin-link" id="openGiftAidHistoryModal">Gift Aid History<i class="bi bi-chevron-right"></i></button>
          </div>
          <div class="pb-admin-card-foot">
            <a href="/all-donations/1">View All Donations</a>
          </div>
        </div>

        <!-- Data & Users -->
        <div class="pb-admin-card" id="data">
          <div class="pb-admin-card-head">
            <div class="title"><i class="bi bi-people-fill"></i>Data &amp; Users</div>
            <span class="count-pill">5 Actions</span>
          </div>
          <div class="pb-admin-card-body">
            <a href="/import-transactions" class="pb-admin-link">Import Transactions<i class="bi bi-chevron-right"></i></a>
            <button type="button" class="pb-admin-link" id="openInviteModal">Invite User<span class="badge-new">NEW</span><i class="bi bi-chevron-right ms-auto"></i></button>
            <button type="button" class="pb-admin-link" id="openResendInviteModal">Resend Invite<i class="bi bi-chevron-right"></i></button>
            <a href="/update-users" class="pb-admin-link">Manage Users<i class="bi bi-chevron-right"></i></a>
            <a href="/select-inactive" class="pb-admin-link">Inactive Donors<i class="bi bi-chevron-right"></i></a>
          </div>
        </div>

        <!-- Setup -->
        <div class="pb-admin-card" id="setup">
          <div class="pb-admin-card-head">
            <div class="title"><i class="bi bi-gear-fill"></i>Setup</div>
            <span class="count-pill">2 Actions</span>
          </div>
          <div class="pb-admin-card-body">
            <a href="/addnewtransactiontype" class="pb-admin-link">Add Transaction Type<i class="bi bi-chevron-right"></i></a>
            <a href="/addnewdonationtype" class="pb-admin-link">Add Donation Type<i class="bi bi-chevron-right"></i></a>
            <div class="pb-admin-tip">
              <i class="bi bi-lightbulb-fill"></i>
              <div>
                Need help setting up categories? Visit the <a href="/docs">Setup Guide</a> for detailed instructions.
              </div>
            </div>
          </div>
          <div class="pb-admin-card-foot">
            <a href="/charity/settings">Charity Settings</a>
          </div>
        </div>

        <!-- Billing -->
        <div class="pb-admin-card" id="billing">
          <div class="pb-admin-card-head">
            <div class="title"><i class="bi bi-credit-card-fill"></i>Billing</div>
            <span class="count-pill">1 Action</span>
          </div>
          <div class="pb-admin-card-body">
            <a href="/charity/billing" class="pb-admin-link">Subscription &amp; Invoices<i class="bi bi-chevron-right"></i></a>
          </div>
          <div class="pb-admin-card-foot">
            <a href="/charity/billing">Manage Billing</a>
          </div>
        </div>

        <% if (isSuperAdmin) { %>
          <!-- Super admin only -->
          <div class="pb-admin-card" id="super">
            <div class="pb-admin-card-head">
              <div class="title"><i class="bi bi-shield-lock"></i>Super Admin</div>
              <span class="count-pill">2 Actions</span>
            </div>
            <div class="pb-admin-card-body">
              <button type="button" class="pb-admin-link" id="openCreateCharityModal">Create Charity<i class="bi bi-chevron-right"></i></button>
              <a href="/db-backup" class="pb-admin-link">Database Backup<i class="bi bi-chevron-right"></i></a>
            </div>
          </div>
        <% } %>

      </div>

    </div>
  </div>
</div>

<script>
  // (sidebar is purely help/resources — no anchor toggling required)
  (() => {
  });
</script>

<!-- ── Export Totals Modal ─────────────────────────────────────── -->
<div class="modal fade" id="totalsModal" tabindex="-1" aria-labelledby="totalsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="totalsModalLabel">
          <i class="bi bi-file-earmark-spreadsheet me-2"></i>Export Totals
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="totalsForm" novalidate>

          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label" for="tot_start">Date From</label>
              <input type="date" class="form-control" id="tot_start" name="start_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
            <div class="col-6">
              <label class="form-label" for="tot_end">Date To</label>
              <input type="date" class="form-control" id="tot_end" name="end_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Action</label>
            <div class="d-flex gap-3 flex-wrap">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tot_action" id="tot_action_download" value="download" checked>
                <label class="form-check-label" for="tot_action_download"><i class="bi bi-file-earmark-pdf me-1"></i>Download PDF</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tot_action" id="tot_action_download_csv" value="download_csv">
                <label class="form-check-label" for="tot_action_download_csv"><i class="bi bi-filetype-csv me-1"></i>Download CSV</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tot_action" id="tot_action_email" value="email">
                <label class="form-check-label" for="tot_action_email"><i class="bi bi-envelope me-1"></i>Email (both)</label>
              </div>
            </div>
          </div>

          <div class="mb-3 d-none" id="tot_email_row">
            <label class="form-label" for="tot_email">Send To Email</label>
            <input type="email" class="form-control" id="tot_email" name="email" placeholder="recipient@example.com">
          </div>

          <div id="totError" class="alert alert-danger d-none" role="alert"></div>
          <div id="totSuccess" class="alert alert-success d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="totSubmitBtn">
          <span id="totSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-file-earmark-pdf me-1" id="totIcon"></i>Generate
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Export Transactions Modal ───────────────────────────────── -->
