<%- include("_loggedInHeader") -%>

<div class="pb-page">
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Admin Console</h1>
      <p class="pb-page-subtitle">System configuration and management</p>
    </div>
  </div>

  <div class="pb-admin-grid">

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">Configuration</div>
      <div class="pb-admin-section-body">
        <a href="/addnewtransactiontype" class="pb-admin-btn">
          <i class="bi bi-plus-circle pb-admin-btn-icon" aria-hidden="true"></i>Add New Transaction Type
        </a>
        <a href="/addnewdonationtype" class="pb-admin-btn">
          <i class="bi bi-plus-circle pb-admin-btn-icon" aria-hidden="true"></i>Add New Donation Type
        </a>
      </div>
    </div>

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">Export</div>
      <div class="pb-admin-section-body">
        <button type="button" class="pb-admin-btn" id="openTransactionModal">
          <i class="bi bi-file-earmark-arrow-down-fill pb-admin-btn-icon" aria-hidden="true"></i>Export Transactions
        </button>
        <button type="button" class="pb-admin-btn" id="openDonationsModal">
          <i class="bi bi-file-earmark-arrow-down-fill pb-admin-btn-icon" aria-hidden="true"></i>Export Donations
        </button>
        <button type="button" class="pb-admin-btn" id="openGiftAidModal">
          <i class="bi bi-file-earmark-arrow-down-fill pb-admin-btn-icon" aria-hidden="true"></i>Claim Gift Aid
        </button>
        <button type="button" class="pb-admin-btn" id="openTotalsModal">
          <i class="bi bi-file-earmark-arrow-down-fill pb-admin-btn-icon" aria-hidden="true"></i>Export Totals
        </button>
      </div>
    </div>

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">Import</div>
      <div class="pb-admin-section-body">
        <a href="/import-transactions" class="pb-admin-btn">
          <i class="bi bi-file-earmark-arrow-up-fill pb-admin-btn-icon" aria-hidden="true"></i>Import Transactions
        </a>
      </div>
    </div>

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">Open Banking</div>
      <div class="pb-admin-section-body">
        <a href="/admin/bank" class="pb-admin-btn">
          <i class="bi bi-bank pb-admin-btn-icon" aria-hidden="true"></i>Bank Connection
        </a>
      </div>
    </div>

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">Charity</div>
      <div class="pb-admin-section-body">
        <a href="/charity/settings" class="pb-admin-btn">
          <i class="bi bi-gear-fill pb-admin-btn-icon" aria-hidden="true"></i>Charity Settings
        </a>
      </div>
    </div>

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">System</div>
      <div class="pb-admin-section-body">
        <a href="/update-users" class="pb-admin-btn">
          <i class="bi bi-people-fill pb-admin-btn-icon" aria-hidden="true"></i>Update Users
        </a>
        <a href="/select-inactive" class="pb-admin-btn">
          <i class="bi bi-person-dash pb-admin-btn-icon" aria-hidden="true"></i>Select Inactive Donors
        </a>
        <% if (isSuperAdmin) { %>
        <a href="/db-backup" class="pb-admin-btn">
          <i class="bi bi-database-down pb-admin-btn-icon" aria-hidden="true"></i>Backup Database
        </a>
        <a href="/software-logs/1" class="pb-admin-btn">
          <i class="bi bi-code-slash pb-admin-btn-icon" aria-hidden="true"></i>Logs
        </a>
        <% } %>
        <a href="/suggest-update" class="pb-admin-btn">
          <i class="bi bi-pencil-square pb-admin-btn-icon" aria-hidden="true"></i>Suggest Update
        </a>
        <a href="/dashboard" class="pb-admin-btn">
          <i class="bi bi-bar-chart pb-admin-btn-icon" aria-hidden="true"></i>View Dashboard
        </a>
      </div>
    </div>

    <div class="pb-admin-section">
      <div class="pb-admin-section-header">Organisation</div>
      <div class="pb-admin-section-body">
        <button type="button" class="pb-admin-btn" id="openInviteModal">
          <i class="bi bi-envelope-plus pb-admin-btn-icon" aria-hidden="true"></i>Invite User
        </button>
        <button type="button" class="pb-admin-btn" id="openResendInviteModal">
          <i class="bi bi-envelope-arrow-up pb-admin-btn-icon" aria-hidden="true"></i>Resend Invite
        </button>
        <% if (isSuperAdmin) { %>
        <button type="button" class="pb-admin-btn" id="openCreateCharityModal">
          <i class="bi bi-building-add pb-admin-btn-icon" aria-hidden="true"></i>Create Charity
        </button>
        <% } %>
      </div>
    </div>

  </div>
</div>

<!-- ── Export Totals Modal ─────────────────────────────────────── -->
<div class="modal fade" id="totalsModal" tabindex="-1" aria-labelledby="totalsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="totalsModalLabel">
          <i class="bi bi-file-earmark-spreadsheet me-2"></i>Export Totals
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="totalsForm" novalidate>

          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label" for="tot_start">Date From</label>
              <input type="date" class="form-control" id="tot_start" name="start_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
            <div class="col-6">
              <label class="form-label" for="tot_end">Date To</label>
              <input type="date" class="form-control" id="tot_end" name="end_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="tot_email">Send To Email</label>
            <input type="email" class="form-control" id="tot_email" name="email" placeholder="recipient@example.com" required>
            <div class="invalid-feedback">A valid email address is required.</div>
          </div>

          <div id="totError" class="alert alert-danger d-none" role="alert"></div>
          <div id="totSuccess" class="alert alert-success d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="totSubmitBtn">
          <span id="totSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-send me-1" id="totIcon"></i>Send Report
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Export Transactions Modal ───────────────────────────────── -->
<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="transactionModalLabel">
          <i class="bi bi-file-earmark-pdf me-2"></i>Export Transactions
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="transactionForm" novalidate>

          <div class="mb-3">
            <label class="form-label" for="tx_export">Export</label>
            <select class="form-select" name="export" id="tx_export" required>
              <option value="everything">Everything</option>
              <option value="allPaidIn">All Paid In</option>
              <option value="allPaidOut">All Paid Out</option>
              <option value="allPaidOutOver£2000">All Paid Out Over £2000</option>
              <% (transactionTypes || []).forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label" for="tx_start">Date From</label>
              <input type="date" class="form-control" id="tx_start" name="start_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
            <div class="col-6">
              <label class="form-label" for="tx_end">Date To</label>
              <input type="date" class="form-control" id="tx_end" name="end_date" required>
              <div class="invalid-feedback">Required.</div>
            </div>
          </div>

          <div id="txError" class="alert alert-danger d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="txSubmitBtn">
          <span id="txSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-download me-1" id="txIcon"></i>Download PDF
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Export Donations Modal ──────────────────────────────────── -->
<div class="modal fade" id="donationsModal" tabindex="-1" aria-labelledby="donationsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="donationsModalLabel">
          <i class="bi bi-file-earmark-pdf me-2"></i>Export Donations
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="donationsForm" novalidate>

          <div class="mb-3">
            <label class="form-label" for="dn_fund">Fund Type</label>
            <select class="form-select" name="fund" id="dn_fund">
              <option value="all">All Types</option>
              <% (donationTypes || []).forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label" for="dn_start">Date From</label>
              <input type="date" class="form-control" id="dn_start" name="start_date">
            </div>
            <div class="col-6">
              <label class="form-label" for="dn_end">Date To</label>
              <input type="date" class="form-control" id="dn_end" name="end_date">
            </div>
          </div>

          <div id="dnError" class="alert alert-danger d-none" role="alert"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="dnSubmitBtn">
          <span id="dnSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-download me-1" id="dnIcon"></i>Download PDF
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  async function fetchPdfDownload(url, payload, filename, { spinner, icon, errorBox, submitBtn }) {
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    submitBtn.disabled = true;
    errorBox.classList.add('d-none');
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Server error');
      }
      const blob = await res.blob();
      const objectUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = objectUrl;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(objectUrl);
    } catch (err) {
      errorBox.textContent = err.message || 'Failed to generate PDF.';
      errorBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      icon.classList.remove('d-none');
      submitBtn.disabled = false;
    }
  }

  // ── Totals modal ───────────────────────────────────────────────
  const totalsModal   = new bootstrap.Modal(document.getElementById('totalsModal'));
  const totalsForm    = document.getElementById('totalsForm');
  const totSubmit     = document.getElementById('totSubmitBtn');
  const totSpinner    = document.getElementById('totSpinner');
  const totIcon       = document.getElementById('totIcon');
  const totError      = document.getElementById('totError');
  const totSuccess    = document.getElementById('totSuccess');

  document.getElementById('openTotalsModal').addEventListener('click', () => {
    totalsForm.reset();
    totalsForm.classList.remove('was-validated');
    totError.classList.add('d-none');
    totSuccess.classList.add('d-none');
    totalsModal.show();
  });

  totSubmit.addEventListener('click', async () => {
    totalsForm.classList.add('was-validated');
    if (!totalsForm.checkValidity()) return;

    const start = document.getElementById('tot_start').value;
    const end   = document.getElementById('tot_end').value;
    const email = document.getElementById('tot_email').value;

    totSpinner.classList.remove('d-none');
    totIcon.classList.add('d-none');
    totSubmit.disabled = true;
    totError.classList.add('d-none');
    totSuccess.classList.add('d-none');

    try {
      const res = await fetch('/export-totals', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ start_date: start, end_date: end, email }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Server error');
      totSuccess.textContent = `Report sent successfully to ${email}.`;
      totSuccess.classList.remove('d-none');
    } catch (err) {
      totError.textContent = err.message || 'Failed to send report.';
      totError.classList.remove('d-none');
    } finally {
      totSpinner.classList.add('d-none');
      totIcon.classList.remove('d-none');
      totSubmit.disabled = false;
    }
  });

  // ── Transactions modal ─────────────────────────────────────────
  const txModal   = new bootstrap.Modal(document.getElementById('transactionModal'));
  const txForm    = document.getElementById('transactionForm');
  const txSubmit  = document.getElementById('txSubmitBtn');
  const txSpinner = document.getElementById('txSpinner');
  const txIcon    = document.getElementById('txIcon');
  const txError   = document.getElementById('txError');

  document.getElementById('openTransactionModal').addEventListener('click', () => {
    txForm.reset();
    txForm.classList.remove('was-validated');
    txError.classList.add('d-none');
    txModal.show();
  });

  txSubmit.addEventListener('click', async () => {
    txForm.classList.add('was-validated');
    if (!txForm.checkValidity()) return;
    const start = document.getElementById('tx_start').value;
    const end   = document.getElementById('tx_end').value;
    const exp   = document.getElementById('tx_export').value;
    await fetchPdfDownload(
      '/generate-transaction-pdf',
      { start_date: start, end_date: end, export: exp },
      `transactions_${start}_to_${end}.pdf`,
      { spinner: txSpinner, icon: txIcon, errorBox: txError, submitBtn: txSubmit },
    );
  });

  // ── Donations modal ────────────────────────────────────────────
  const dnModal   = new bootstrap.Modal(document.getElementById('donationsModal'));
  const dnForm    = document.getElementById('donationsForm');
  const dnSubmit  = document.getElementById('dnSubmitBtn');
  const dnSpinner = document.getElementById('dnSpinner');
  const dnIcon    = document.getElementById('dnIcon');
  const dnError   = document.getElementById('dnError');

  document.getElementById('openDonationsModal').addEventListener('click', () => {
    dnForm.reset();
    dnError.classList.add('d-none');
    dnModal.show();
  });

  dnSubmit.addEventListener('click', async () => {
    const fund  = document.getElementById('dn_fund').value;
    const start = document.getElementById('dn_start').value;
    const end   = document.getElementById('dn_end').value;
    const date  = new Date().toISOString().slice(0, 10);
    const slug  = fund && fund !== 'all' ? `_${fund.replace(/[^a-z0-9]/gi, '_')}` : '';
    await fetchPdfDownload(
      '/export-donations',
      { fund, start_date: start || null, end_date: end || null },
      `donations_export${slug}_${date}.pdf`,
      { spinner: dnSpinner, icon: dnIcon, errorBox: dnError, submitBtn: dnSubmit },
    );
  });

});
</script>

<!-- ── Gift Aid Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="giftAidModal" tabindex="-1" aria-labelledby="giftAidModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="giftAidModalLabel"><i class="bi bi-file-earmark-check me-2"></i>Claim Gift Aid</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="giftAidLoading" class="text-center py-3">
          <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading summary...
        </div>
        <div id="giftAidSummary" class="d-none">
          <table class="table table-sm table-borderless mb-0">
            <thead class="table-light">
              <tr><th>Category</th><th class="text-center">Count</th><th class="text-end">Amount</th></tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-muted">Unclaimed donations</td>
                <td class="text-center" id="gaDonationCount">—</td>
                <td class="fw-semibold text-end" id="gaDonationTotal">—</td>
              </tr>
              <tr class="table-success">
                <td class="fw-semibold">Receivable from HMRC</td>
                <td></td>
                <td class="fw-bold text-end" id="gaReceivable">—</td>
              </tr>
            </tbody>
          </table>
          <p class="text-muted mt-3 mb-0" style="font-size:0.8rem;">Gift Aid is calculated at 25% on donations only. Clicking <strong>Export &amp; Mark Claimed</strong> will download the CSV and mark all unclaimed donations as claimed.</p>
        </div>
        <div id="giftAidNone" class="d-none text-muted text-center py-3">No unclaimed donations found.</div>
        <div id="giftAidError" class="alert alert-danger d-none mt-2" role="alert"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success d-none" id="gaExportBtn">
          <span id="gaSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-download me-1" id="gaIcon"></i>Export &amp; Mark Claimed
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Invite User Modal ────────────────────────────────────────── -->
<div class="modal fade" id="inviteModal" tabindex="-1" aria-labelledby="inviteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="inviteModalLabel"><i class="bi bi-envelope-plus me-2"></i>Invite User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/charity/invite" method="post">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input required type="email" name="email" class="form-control" placeholder="user@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Role</label>
            <select required name="role" class="form-select">
              <option value="user">User</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Send Invite</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ── Resend Invite Modal ──────────────────────────────────────── -->
<div class="modal fade" id="resendInviteModal" tabindex="-1" aria-labelledby="resendInviteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="resendInviteModalLabel"><i class="bi bi-envelope-arrow-up me-2"></i>Resend Invite</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p style="font-size:0.85rem;color:var(--pb-gray-400);">Enter the email address of a pending invite to resend it. A new 48-hour token will be generated.</p>
        <div class="mb-3">
          <label class="form-label">Email Address</label>
          <input required type="email" id="resendEmail" class="form-control" placeholder="user@example.com">
        </div>
        <div id="resendError" class="alert alert-danger d-none" role="alert"></div>
        <div id="resendSuccess" class="alert alert-success d-none" role="alert"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="resendSubmitBtn">
          <span id="resendSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-send me-1" id="resendIcon"></i>Resend
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Create Charity Modal (super admin only) ──────────────────── -->
<div class="modal fade" id="createCharityModal" tabindex="-1" aria-labelledby="createCharityModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header pb-modal-header">
        <h5 class="modal-title" id="createCharityModalLabel"><i class="bi bi-building-add me-2"></i>Create Charity</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/charities" method="post">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Charity Name</label>
            <input required type="text" name="name" class="form-control" placeholder="NewLife Church Sunderland">
          </div>
          <div class="mb-3">
            <label class="form-label">Slug <small class="text-muted">(unique, lowercase, hyphens only)</small></label>
            <input required type="text" name="slug" class="form-control" placeholder="newlife-sunderland" pattern="[a-z0-9\-]+" title="Lowercase letters, numbers and hyphens only">
          </div>
          <div class="mb-3">
            <label class="form-label">Charity Contact Email <small class="text-muted">(optional)</small></label>
            <input type="email" name="email" class="form-control" placeholder="info@charity.org">
          </div>
          <div class="mb-3">
            <label class="form-label">First Admin Email</label>
            <input required type="email" name="admin_email" class="form-control" placeholder="admin@charity.org">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-building-add me-1"></i>Create &amp; Send Invite</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // ── Gift Aid modal ─────────────────────────────────────────────
  const giftAidModal = new bootstrap.Modal(document.getElementById('giftAidModal'));

  document.getElementById('openGiftAidModal').addEventListener('click', async () => {
    document.getElementById('giftAidLoading').classList.remove('d-none');
    document.getElementById('giftAidSummary').classList.add('d-none');
    document.getElementById('giftAidNone').classList.add('d-none');
    document.getElementById('giftAidError').classList.add('d-none');
    document.getElementById('gaExportBtn').classList.add('d-none');
    giftAidModal.show();

    try {
      const res  = await fetch('/api/giftaid-summary');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Server error');

      document.getElementById('giftAidLoading').classList.add('d-none');

      const fmt = v => '£' + parseFloat(v).toLocaleString('en-GB', { minimumFractionDigits: 2 });
      if (data.donationCount === 0) {
        document.getElementById('giftAidNone').classList.remove('d-none');
      } else {
        document.getElementById('gaDonationCount').textContent = data.donationCount;
        document.getElementById('gaDonationTotal').textContent = fmt(data.donationTotal);
        document.getElementById('gaReceivable').textContent    = fmt(data.receivable);
        document.getElementById('giftAidSummary').classList.remove('d-none');
        document.getElementById('gaExportBtn').classList.remove('d-none');
      }
    } catch (err) {
      document.getElementById('giftAidLoading').classList.add('d-none');
      document.getElementById('giftAidError').textContent = err.message || 'Could not load summary.';
      document.getElementById('giftAidError').classList.remove('d-none');
    }
  });

  document.getElementById('gaExportBtn').addEventListener('click', async () => {
    const spinner = document.getElementById('gaSpinner');
    const icon    = document.getElementById('gaIcon');
    const errBox  = document.getElementById('giftAidError');
    const btn     = document.getElementById('gaExportBtn');

    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    btn.disabled = true;
    errBox.classList.add('d-none');

    try {
      const res = await fetch('/export-giftaid-claims', { method: 'POST' });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Export failed.');
      }
      // Download the CSV file returned
      const blob = await res.blob();
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = 'giftaid_claim.csv';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      giftAidModal.hide();
    } catch (err) {
      errBox.textContent = err.message || 'Export failed.';
      errBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      icon.classList.remove('d-none');
      btn.disabled = false;
    }
  });

  document.getElementById('openInviteModal')?.addEventListener('click', () => {
    new bootstrap.Modal(document.getElementById('inviteModal')).show();
  });

  document.getElementById('openCreateCharityModal')?.addEventListener('click', () => {
    new bootstrap.Modal(document.getElementById('createCharityModal')).show();
  });

  // Resend invite
  const resendModal = new bootstrap.Modal(document.getElementById('resendInviteModal'));
  document.getElementById('openResendInviteModal').addEventListener('click', () => {
    document.getElementById('resendEmail').value = '';
    document.getElementById('resendError').classList.add('d-none');
    document.getElementById('resendSuccess').classList.add('d-none');
    resendModal.show();
  });

  document.getElementById('resendSubmitBtn').addEventListener('click', async () => {
    const email   = document.getElementById('resendEmail').value.trim();
    const errBox  = document.getElementById('resendError');
    const okBox   = document.getElementById('resendSuccess');
    const spinner = document.getElementById('resendSpinner');
    const icon    = document.getElementById('resendIcon');
    const btn     = document.getElementById('resendSubmitBtn');

    errBox.classList.add('d-none');
    okBox.classList.add('d-none');
    if (!email) { errBox.textContent = 'Please enter an email address.'; errBox.classList.remove('d-none'); return; }

    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    btn.disabled = true;

    // Super admins use the global endpoint; charity admins use the scoped one
    const endpoint = <%= isSuperAdmin ? 'true' : 'false' %> ? '/admin/invite/resend' : '/charity/invite/resend';

    try {
      const res  = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Server error');
      okBox.textContent = `Invite resent to ${email}.`;
      okBox.classList.remove('d-none');
    } catch (err) {
      errBox.textContent = err.message || 'Failed to resend invite.';
      errBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      icon.classList.remove('d-none');
      btn.disabled = false;
    }
  });
});
</script>

<%- include("_loggedInFooter") -%>
