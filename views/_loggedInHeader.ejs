<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ProBooks Accounting — church and non-profit accounting management system.">
  <title>ProBooks Accounting</title>
  <link rel="icon" href="../css/favicon.ico" type="image/x-icon">
  <link rel="icon" href="../css/favicon-16x16.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/custom.css?v=10">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous" defer></script>
  <script src="/js/app.js" defer></script>
</head>

<body>

  <div class="container">

    <nav class="navbar sticky-top navbar-expand-lg pb-navbar">
      <div class="container-fluid px-0">
        <a class="navbar-brand" href="/"><img src="/css/probooks.png" alt="ProBooks" class="pb-navbar-logo"></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/claimants/1">Members</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/all-donations/1">Donations</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Bank Transactions
              </a>
              <ul class="dropdown-menu">
                <% if (availableYears && availableYears.length) { %>
                  <% for (const year of availableYears) { %>
                    <li><a class="dropdown-item" href="/yearly-transactions/<%= year %>/1"><%= year %></a></li>
                  <% } %>
                <% } else { %>
                  <li><span class="dropdown-item text-muted">No data yet</span></li>
                <% } %>
              </ul>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin">Admin Console</a>
            </li>
          </ul>
          <div class="pb-navbar-user">
            <span class="pb-navbar-username">Logged in as <%= loggedInName %></span>
            <a class="btn btn-outline-secondary btn-sm btn-logout" href="/logout">Sign out</a>
          </div>
        </div>
      </div>
    </nav>

    <% if (message.success) { %>
      <div class="alert alert-success alert-dismissible fade show mt-3 pb-flash" role="alert" aria-live="polite">
          <%= message.success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (message.error) { %>
      <div class="alert alert-danger alert-dismissible fade show mt-3 pb-flash" role="alert" aria-live="polite">
          <%= message.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
