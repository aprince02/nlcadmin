<%- include("_loggedInHeader") -%>

<div class="pb-page">
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Update Member</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/claimants/1">Members</a></li>
          <li class="breadcrumb-item active" aria-current="page">Update Member</li>
        </ol>
      </nav>
    </div>
    <div class="pb-page-actions d-print-none">
      <a class="btn btn-warning" href="/send-update-request/<%= member.id %>">
        <i class="bi bi-envelope" aria-hidden="true"></i> Request Member to Update
      </a>
    </div>
  </div>

  <form action="/edit/<%= member.id %>" method="post">
    <%- include("_claimantEditor") -%>

    <div class="d-flex gap-2 mt-2 mb-4">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a class="btn btn-outline-secondary" href="/claimants/1">Cancel</a>
    </div>
  </form>
</div>

<%- include("_loggedInFooter") -%>
