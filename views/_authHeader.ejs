<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ProBooks Accounting — church and non-profit accounting management system.">
  <title>ProBooks Accounting</title>
  <link rel="icon" href="../css/favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/custom.css?v=10">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous" defer></script>
  <script src="/js/app.js" defer></script>
</head>

<body class="pb-auth-body">

  <nav class="navbar pb-navbar px-4">
    <a class="navbar-brand" href="/"><img src="/css/probooks.png" alt="ProBooks" class="pb-navbar-logo"></a>
  </nav>

  <% if (message.success) { %>
    <div class="alert alert-success alert-dismissible fade show pb-flash" role="alert" aria-live="polite"
         style="position:fixed;top:64px;left:50%;transform:translateX(-50%);width:auto;max-width:420px;z-index:1050;">
        <%= message.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (message.error) { %>
    <div class="alert alert-danger alert-dismissible fade show pb-flash" role="alert" aria-live="polite"
         style="position:fixed;top:64px;left:50%;transform:translateX(-50%);width:auto;max-width:420px;z-index:1050;">
        <%= message.error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
