<%- include("../_loggedInHeader") -%>

<div class="pb-page">
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Platform</h1>
      <p class="pb-page-subtitle">All charities on ProBooks Accounting</p>
    </div>
    <div class="pb-page-actions">
      <a href="/platform/dashboard" class="btn btn-outline-primary">
        <i class="bi bi-bar-chart me-1"></i>Dashboard
      </a>
      <a href="/platform/giftaid-claims" class="btn btn-outline-primary">
        <i class="bi bi-file-earmark-check me-1"></i>Gift Aid Claims
      </a>
      <a href="/software-logs/1" class="btn btn-outline-secondary">
        <i class="bi bi-code-slash me-1"></i>Logs
      </a>
    </div>
  </div>

  <div class="pb-table-card">
    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Charity</th>
            <th>Subscription</th>
            <th class="text-center">Users</th>
            <th class="text-center">Members</th>
            <th>Last login</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          <% charities.forEach(c => { %>
            <% const isInactive = c.is_active === 0; %>
            <% let daysUntilDeletion = null; %>
            <% if (isInactive && c.deactivated_at) {
                 const ms = Date.now() - new Date(c.deactivated_at).getTime();
                 daysUntilDeletion = Math.max(0, 90 - Math.floor(ms / 86400000));
               } %>
            <tr<%= isInactive ? ' class="table-secondary"' : '' %>>
              <td>
                <div class="fw-semibold">
                  <%= c.name %>
                  <% if (isInactive) { %>
                    <span class="badge bg-dark ms-1">Deactivated</span>
                  <% } %>
                </div>
                <div class="text-muted small"><%= c.slug %></div>
                <% if (isInactive && daysUntilDeletion !== null) { %>
                  <div class="text-danger small">
                    <i class="bi bi-trash3 me-1"></i>
                    Data deletion in <%= daysUntilDeletion %> day<%= daysUntilDeletion === 1 ? '' : 's' %>
                  </div>
                <% } %>
              </td>
              <td>
                <% if (c.subscription_status === 'active') { %>
                  <span class="badge bg-success">Active</span>
                <% } else if (c.subscription_status === 'past_due') { %>
                  <span class="badge bg-warning text-dark">Past due</span>
                <% } else if (c.subscription_status === 'canceled' || c.subscription_status === 'unpaid') { %>
                  <span class="badge bg-danger"><%= c.subscription_status === 'unpaid' ? 'Unpaid' : 'Cancelled' %></span>
                <% } else { %>
                  <span class="badge bg-secondary">None</span>
                <% } %>
                <% if (c.subscription_plan) { %>
                  <small class="text-muted ms-1"><%= c.subscription_plan === 'yearly' ? 'Yearly' : 'Monthly' %></small>
                <% } %>
              </td>
              <td class="text-center"><%= c.user_count %></td>
              <td class="text-center"><%= c.member_count %></td>
              <td class="text-muted small">
                <% if (c.last_login_at) { %>
                  <% const loginDate = new Date(c.last_login_at); %>
                  <% const days = Math.floor((Date.now() - loginDate.getTime()) / 86400000); %>
                  <%= loginDate.toLocaleDateString('en-GB') %>
                  <div class="text-muted" style="font-size:0.75rem;">
                    <%= days === 0 ? 'today' : days === 1 ? 'yesterday' : days + ' days ago' %>
                  </div>
                <% } else { %>
                  —
                <% } %>
              </td>
              <td class="text-end">
                <% if (isInactive) { %>
                  <form method="POST" action="/platform/charities/<%= c.id %>/reactivate" class="d-inline"
                        onsubmit="return confirm('Reactivate <%= c.name.replace(/'/g, '&#39;') %>? This cancels the scheduled deletion.');">
                    <button type="submit" class="btn btn-sm btn-success">
                      <i class="bi bi-arrow-counterclockwise me-1"></i>Reactivate
                    </button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/platform/act-as/<%= c.id %>" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-box-arrow-in-right me-1"></i>View as
                    </button>
                  </form>
                  <form method="POST" action="/platform/charities/<%= c.id %>/deactivate" class="d-inline ms-1"
                        onsubmit="return confirm('Deactivate <%= c.name.replace(/'/g, '&#39;') %>?\n\n• Stripe subscription will be set to cancel at period end\n• Bank connections will be disabled\n• Users can no longer sign in\n• ALL DATA WILL BE PERMANENTLY DELETED IN 90 DAYS\n\nYou can reactivate within that 90-day window to restore everything.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-x-circle me-1"></i>Deactivate
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (charities.length === 0) { %>
            <tr><td colspan="6" class="text-muted text-center py-4">No charities yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include("../_footer") -%>
