<%- include("../_loggedInHeader") -%>

<div class="pb-page">
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Platform Dashboard</h1>
      <p class="pb-page-subtitle">Platform-wide status at a glance</p>
    </div>
    <div class="pb-page-actions">
      <a href="/platform" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>All charities
      </a>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
      <div class="pb-table-card p-4 h-100">
        <div class="d-flex align-items-center text-primary mb-2">
          <i class="bi bi-people-fill fs-4 me-2"></i>
          <span class="fw-semibold">Active Users</span>
        </div>
        <div class="display-5 fw-bold"><%= activeUsers.toLocaleString('en-GB') %></div>
        <div class="text-muted small">approved across all charities</div>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="pb-table-card p-4 h-100">
        <div class="d-flex align-items-center text-primary mb-2">
          <i class="bi bi-credit-card fs-4 me-2"></i>
          <span class="fw-semibold">Subscriptions</span>
        </div>
        <table class="table table-sm mb-0">
          <tbody>
            <tr><td class="text-muted small">Active</td><td class="text-end fw-semibold"><%= subs.active %></td></tr>
            <tr><td class="text-muted small">Past due</td><td class="text-end fw-semibold text-warning"><%= subs.past_due %></td></tr>
            <tr><td class="text-muted small">Cancelled</td><td class="text-end fw-semibold text-danger"><%= subs.cancelled %></td></tr>
            <tr><td class="text-muted small">None</td><td class="text-end fw-semibold text-muted"><%= subs.none %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="pb-table-card p-4 h-100">
        <div class="d-flex align-items-center text-primary mb-2">
          <i class="bi bi-bank fs-4 me-2"></i>
          <span class="fw-semibold">Last Bank Sync</span>
        </div>
        <div class="fw-semibold">
          <%= lastBankSync ? new Date(lastBankSync).toLocaleString('en-GB') : 'Never' %>
        </div>
        <div class="text-muted small">most recent across all connected charities</div>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="pb-table-card p-4 h-100">
        <div class="d-flex align-items-center <%= recentErrors > 0 ? 'text-danger' : 'text-primary' %> mb-2">
          <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
          <span class="fw-semibold">Recent Errors</span>
        </div>
        <div class="display-5 fw-bold"><%= recentErrors %></div>
        <div class="text-muted small">in the last 24 hours</div>
        <a href="/software-logs/1" class="btn btn-sm btn-outline-secondary mt-2">View logs</a>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="pb-table-card p-4 h-100">
        <div class="d-flex align-items-center text-primary mb-3">
          <i class="bi bi-chat-dots-fill fs-4 me-2"></i>
          <span class="fw-semibold">SMS Costs (this month)</span>
        </div>

        <div class="row g-3">
          <div class="col-md-4">
            <div class="text-muted small text-uppercase fw-semibold">Total this month</div>
            <div class="display-5 fw-bold">£<%= sms.costThisMonth.toFixed(2) %></div>
            <table class="table table-sm mb-0 mt-2">
              <tbody>
                <tr>
                  <td class="text-muted small">Number rental</td>
                  <td class="text-end fw-semibold">£<%= sms.rentalGbp.toFixed(2) %></td>
                </tr>
                <tr>
                  <td class="text-muted small"><%= sms.countThisMonth %> msg<%= sms.countThisMonth === 1 ? '' : 's' %> &times; <%= (sms.perMessageGbp * 100).toFixed(0) %>p</td>
                  <td class="text-end fw-semibold">£<%= (sms.countThisMonth * sms.perMessageGbp).toFixed(2) %></td>
                </tr>
                <tr class="border-top">
                  <td class="text-muted small">All-time messages</td>
                  <td class="text-end fw-semibold"><%= sms.countAllTime %></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="col-md-8">
            <div class="text-muted small text-uppercase fw-semibold mb-2">By charity</div>
            <% if (sms.byCharity.length === 0) { %>
              <div class="text-muted">No SMS sent yet.</div>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm mb-0">
                  <thead>
                    <tr>
                      <th>Charity</th>
                      <th class="text-end">This month</th>
                      <th class="text-end">Cost (msgs)</th>
                      <th class="text-end">All time</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% sms.byCharity.forEach(c => { %>
                      <tr>
                        <td><%= c.name %></td>
                        <td class="text-end"><%= c.countMonth %></td>
                        <td class="text-end fw-semibold">£<%= c.costMonth.toFixed(2) %></td>
                        <td class="text-end text-muted"><%= c.countAllTime %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="text-muted small mb-0 mt-2">
                Cost shown is per-charity message volume only. The £<%= sms.rentalGbp.toFixed(2) %> number rental is shared across all charities.
              </p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include("../_footer") -%>
