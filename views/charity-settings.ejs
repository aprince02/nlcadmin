<%- include("_loggedInHeader") -%>

<div class="pb-page">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/admin">Admin Console</a></li>
      <li class="breadcrumb-item active" aria-current="page">Charity Settings</li>
    </ol>
  </nav>

  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Charity Settings</h1>
      <p class="pb-page-subtitle">Update your charity details and logo</p>
    </div>
  </div>

  <div class="row g-4">

    <!-- ── Details form ─────────────────────────────────────────────── -->
    <div class="col-lg-8">
      <div class="pb-table-card p-4">
        <h5 class="mb-3"><i class="bi bi-building me-2"></i>Charity Details</h5>
        <form method="POST" action="/charity/settings" novalidate>

          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label" for="cs_name">Charity Name</label>
              <input type="text" class="form-control" id="cs_name" name="name" value="<%= charity.name || '' %>" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="cs_charity_no">Charity Number</label>
              <input type="text" class="form-control" id="cs_charity_no" name="charity_no" value="<%= charity.charity_no || '' %>">
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="cs_email">Email</label>
              <input type="email" class="form-control" id="cs_email" name="email" value="<%= charity.email || '' %>">
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="cs_phone">Phone</label>
              <input type="text" class="form-control" id="cs_phone" name="phone" value="<%= charity.phone || '' %>">
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="cs_website">Website</label>
              <input type="url" class="form-control" id="cs_website" name="website" value="<%= charity.website || '' %>">
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="cs_treasurer">Treasurer Name</label>
              <input type="text" class="form-control" id="cs_treasurer" name="treasurer_name" value="<%= charity.treasurer_name || '' %>">
            </div>
            <div class="col-12">
              <label class="form-label" for="cs_address">Address</label>
              <textarea class="form-control" id="cs_address" name="address" rows="2"><%= charity.address || '' %></textarea>
            </div>
          </div>

          <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Save Details</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Logo upload ───────────────────────────────────────────────── -->
    <div class="col-lg-4">
      <div class="pb-table-card p-4 h-100">
        <h5 class="mb-3"><i class="bi bi-image me-2"></i>Charity Logo</h5>

        <% if (charity.logo_path) { %>
          <div class="mb-3 text-center">
            <img src="<%= charity.logo_path %>" alt="Charity logo" class="img-fluid rounded border" style="max-height:120px; object-fit:contain;">
            <p class="text-muted mt-2" style="font-size:0.8rem;">Current logo</p>
          </div>
        <% } else { %>
          <p class="text-muted mb-3">No logo uploaded yet. The default ProBooks logo will be used on PDFs.</p>
        <% } %>

        <form method="POST" action="/charity/settings/logo" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label" for="cs_logo">Upload new logo</label>
            <input type="file" class="form-control" id="cs_logo" name="logo" accept="image/*" required>
            <div class="form-text">PNG, JPG, GIF or WebP — max 2 MB. Used on all generated PDFs.</div>
          </div>
          <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-upload me-1"></i>Upload Logo</button>
        </form>
      </div>
    </div>

  </div>
</div>

<%- include("_loggedInFooter") -%>
