<div class="form-group row">
  <label class="col-form-label col-sm-2" for="first_name">First Name</label>
  <div class="col-sm-5">
    <input  class="form-control" name="first_name" style="max-width: fit-content;" value="<%= row.first_name %>"/>
  </div>
</div>

<div class="form-group row">
  <label class="col-form-label col-sm-2" for="surname">Surname</label>
  <div class="col-sm-5">
    <input  class="form-control" name="surname" style="max-width: fit-content;" value="<%= row.surname %>"/>
  </div>
</div>

<div class="form-group row">
  <label for="donationAmount" class="col-sm-2 col-form-label">Amount</label>
  <div class="col-sm-10">
    <input type="number" step="0.01" name="amount" id="donationAmount" style="max-width: fit-content;" class="form-control" value="<%= donationAmount || '' %>" required>
  </div>
</div>

<div class="form-group row">
  <label for="donationDate" class="col-sm-2 col-form-label">Date of Donation</label>
  <div class="col-sm-10">
    <input type="date" name="date" id="donationDate" style="max-width: fit-content;" class="form-control" value="<%= donationDate || '' %>" required>
  </div>
</div>

<div class="form-group row">
  <label class="col-form-label col-sm-2" for="fund">Fund</label>
  <div class="col-sm-5">
    <select required class="form-control" style="max-width: fit-content;" name="fund" id="fund">
      <% types.forEach(type => { %>
        <option value="<%= type %>" <%= typeof preselectedFund !== 'undefined' && preselectedFund === type ? 'selected' : '' %>><%= type %></option>
      <% }); %>
    </select>
  </div>  
</div>


<div class="form-group row">
  <label class="col-form-label col-sm-2" for="notes">Note</label>
  <div class="col-sm-5">
    <input class="form-control" name="notes" value="<%= row.notes %>"/>
  </div>
</div>