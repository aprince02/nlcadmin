<div class="row g-3 mb-3">
  <div class="col-sm-5">
    <label class="form-label" for="first_name">First Name</label>
    <input class="form-control pb-field-natural" name="first_name" id="first_name" value="<%= row.first_name %>"/>
  </div>
  <div class="col-sm-5">
    <label class="form-label" for="surname">Surname</label>
    <input class="form-control pb-field-natural" name="surname" id="surname" value="<%= row.surname %>"/>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-sm-4">
    <label class="form-label" for="donationAmount">Amount (£)</label>
    <input type="number" step="0.01" name="amount" id="donationAmount" class="form-control pb-field-natural" value="<%= typeof donationAmount !== 'undefined' ? donationAmount : (row.amount || '') %>" required>
  </div>
  <div class="col-sm-4">
    <label class="form-label" for="donationDate">Date of Donation</label>
    <input type="date" name="date" class="form-control" value="<%= row.date_input || '' %>">
  </div>
</div>

<div class="mb-3">
  <label class="form-label" for="fund">Fund</label>
  <select required class="form-select pb-field-natural" name="fund" id="fund">
    <% types.forEach(type => { %>
      <option value="<%= type %>" <%= typeof preselectedFund !== 'undefined' && preselectedFund === type ? 'selected' : '' %>><%= type %></option>
    <% }); %>
  </select>
</div>

<div class="mb-3">
  <label class="form-label" for="notes">Notes</label>
  <input class="form-control pb-field-full" name="notes" id="notes" value="<%= row.notes %>"/>
</div>
