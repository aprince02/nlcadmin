<%- include("_loggedInHeader") -%>

<div class="pb-page">

  <!-- Page Header -->
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Dashboard</h1>
      <p class="pb-page-subtitle"><%= currentYear %> Overview</p>
    </div>
    <div class="pb-page-actions d-print-none">
      <div class="pb-year-switcher">
        <a class="pb-year-btn" href="/dashboard?year=<%= currentYear - 1 %>" aria-label="Previous year">
          <i class="bi bi-chevron-left"></i>
        </a>
        <span class="pb-year-label"><%= currentYear %></span>
        <a class="pb-year-btn <%= isCurrentYear ? 'disabled' : '' %>"
           href="<%= isCurrentYear ? '#' : '/dashboard?year=' + (currentYear + 1) %>"
           aria-label="Next year"
           aria-disabled="<%= isCurrentYear %>">
          <i class="bi bi-chevron-right"></i>
        </a>
      </div>
      <a class="btn btn-primary btn-sm" href="/select-giver">
        <i class="bi bi-plus-circle" aria-hidden="true"></i> Add Donation
      </a>
      <a class="btn btn-outline-secondary btn-sm" href="/all-donations/1">All Donations</a>
    </div>
  </div>

  <!-- ── Section 1: This Month KPIs ── -->
  <p class="pb-dash-section"><%= isCurrentYear ? 'This Month' : currentYear + ' — Full Year' %></p>
  <div class="pb-kpi-grid mb-4">

    <div class="pb-kpi-card pb-kpi-card--income">
      <span class="pb-kpi-label">Paid In</span>
      <span class="pb-kpi-value">£<%= currentMonthTotals.paidIn.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
      <% if (paidInChange !== null) { %>
        <span class="pb-kpi-change <%= paidInChange >= 0 ? 'up' : 'down' %>">
          <i class="bi bi-arrow-<%= paidInChange >= 0 ? 'up' : 'down' %>-short"></i>
          <%= Math.abs(paidInChange) %>% vs last month
        </span>
      <% } else { %>
        <span class="pb-kpi-change neutral">No prior data</span>
      <% } %>
    </div>

    <div class="pb-kpi-card pb-kpi-card--expense">
      <span class="pb-kpi-label">Paid Out</span>
      <span class="pb-kpi-value">£<%= currentMonthTotals.paidOut.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
      <% if (paidOutChange !== null) { %>
        <span class="pb-kpi-change <%= paidOutChange > 0 ? 'down' : 'up' %>">
          <i class="bi bi-arrow-<%= paidOutChange > 0 ? 'up' : 'down' %>-short"></i>
          <%= Math.abs(paidOutChange) %>% vs last month
        </span>
      <% } else { %>
        <span class="pb-kpi-change neutral">No prior data</span>
      <% } %>
    </div>

    <div class="pb-kpi-card pb-kpi-card--net">
      <span class="pb-kpi-label">Net Position</span>
      <span class="pb-kpi-value pb-kpi-value--<%= currentMonthTotals.net >= 0 ? 'positive' : 'negative' %>">
        <%= currentMonthTotals.net >= 0 ? '+' : '' %>£<%= Math.abs(currentMonthTotals.net).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %>
      </span>
      <span class="pb-kpi-change neutral">Income minus expenses</span>
    </div>

    <div class="pb-kpi-card pb-kpi-card--stat">
      <span class="pb-kpi-label">Donations Recorded</span>
      <span class="pb-kpi-value"><%= monthlyDonationCount %></span>
      <span class="pb-kpi-change neutral">this month</span>
    </div>

  </div>

  <!-- ── Ladies Fund balance ── -->
  <p class="pb-dash-section">Ladies Fund</p>
  <div class="pb-table-card mb-4 p-3 p-md-4">
    <% if (!ladiesFund.hasOpening) { %>
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <div class="fw-semibold mb-1">No opening balance set</div>
          <div class="text-muted small mb-0">
            Set the balance the Ladies Fund had on a chosen date.
            From that point, the system will add income and subtract expenses tagged
            <strong>Ladies Fund</strong> to show the running balance.
          </div>
        </div>
        <% if (isAdmin) { %>
          <button type="button" class="btn btn-primary btn-sm" id="openLadiesFundBtn">
            <i class="bi bi-pencil me-1"></i>Set Opening Balance
          </button>
        <% } else { %>
          <span class="text-muted small">Ask an admin to set the opening balance.</span>
        <% } %>
      </div>
    <% } else { %>
      <div class="row g-3 align-items-center">
        <div class="col-md-4">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Current balance</div>
          <div class="fs-3 fw-bold mb-0 <%= ladiesFund.balance >= 0 ? 'pb-amt-in' : 'pb-amt-out' %>">
            £<%= ladiesFund.balance.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %>
          </div>
        </div>
        <div class="col-md-2">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Opening</div>
          <div>£<%= ladiesFund.openingAmount.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
          <div class="text-muted small">on <%= new Date(ladiesFund.openingDate).toLocaleDateString('en-GB') %></div>
        </div>
        <div class="col-md-2">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Income since</div>
          <div class="pb-amt-in">+£<%= ladiesFund.income.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
        </div>
        <div class="col-md-2">
          <div class="text-muted small text-uppercase fw-semibold mb-1">Expenses since</div>
          <div class="pb-amt-out">-£<%= ladiesFund.expense.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
        </div>
        <div class="col-md-2 text-md-end">
          <% if (isAdmin) { %>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="openLadiesFundBtn">
              <i class="bi bi-pencil me-1"></i>Edit Opening
            </button>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <% if (isAdmin) { %>
    <!-- Opening balance modal -->
    <div class="modal fade" id="ladiesFundModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header pb-modal-header">
            <h5 class="modal-title"><i class="bi bi-piggy-bank me-2"></i>Ladies Fund — Opening Balance</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted small">
              Enter the balance the Ladies Fund had on the date you started using ProBooks.
              All Ladies Fund income and expenses recorded from that date onward will be added or
              subtracted automatically.
            </p>
            <div class="mb-3">
              <label class="form-label" for="lf_date">Opening date</label>
              <input type="date" id="lf_date" class="form-control" value="<%= ladiesFund.openingDate ? new Date(ladiesFund.openingDate).toISOString().slice(0,10) : '' %>">
            </div>
            <div class="mb-3">
              <label class="form-label" for="lf_amount">Opening amount (£)</label>
              <input type="number" id="lf_amount" class="form-control" step="0.01" placeholder="0.00" value="<%= ladiesFund.hasOpening ? ladiesFund.openingAmount.toFixed(2) : '' %>">
            </div>
            <div class="alert alert-danger d-none" id="lf_error" role="alert"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="lf_save">
              <span class="spinner-border spinner-border-sm me-1 d-none" id="lf_spinner" role="status"></span>
              Save
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('ladiesFundModal');
        const modal   = new bootstrap.Modal(modalEl);
        const openBtn = document.getElementById('openLadiesFundBtn');
        const saveBtn = document.getElementById('lf_save');
        const spinner = document.getElementById('lf_spinner');
        const errBox  = document.getElementById('lf_error');

        openBtn?.addEventListener('click', () => {
          errBox.classList.add('d-none');
          modal.show();
        });

        saveBtn.addEventListener('click', async () => {
          const date   = document.getElementById('lf_date').value;
          const amount = document.getElementById('lf_amount').value;
          if (!date || amount === '') {
            errBox.textContent = 'Please enter both date and amount.';
            errBox.classList.remove('d-none');
            return;
          }
          spinner.classList.remove('d-none');
          saveBtn.disabled = true;
          errBox.classList.add('d-none');
          try {
            const res = await fetch('/api/fund-balance/ladies', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ opening_date: date, opening_amount: amount }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Save failed');
            window.location.reload();
          } catch (err) {
            errBox.textContent = err.message || 'Save failed.';
            errBox.classList.remove('d-none');
            spinner.classList.add('d-none');
            saveBtn.disabled = false;
          }
        });
      });
    </script>
  <% } %>

  <!-- ── Section 2: Year to Date KPIs ── -->
  <p class="pb-dash-section">Year to Date — <%= currentYear %></p>
  <div class="pb-kpi-grid pb-kpi-grid--2 mb-4">

    <div class="pb-kpi-card pb-kpi-card--income">
      <span class="pb-kpi-label">Total Donations</span>
      <span class="pb-kpi-value">£<%= parseFloat(ytdDonationTotal).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
      <span class="pb-kpi-change neutral"><%= currentYear %> year to date</span>
    </div>

    <div class="pb-kpi-card pb-kpi-card--stat">
      <span class="pb-kpi-label">Active Members</span>
      <span class="pb-kpi-value"><%= activeMembers %></span>
      <span class="pb-kpi-change neutral">on the membership register</span>
    </div>

  </div>

  <!-- ── Section 3: Charts ── -->
  <p class="pb-dash-section">Trends</p>
  <div class="row g-4 mb-4">
    <div class="col-lg-7">
      <div class="pb-chart-card h-100">
        <p class="pb-chart-title">Monthly Paid In vs Paid Out — <%= currentYear %></p>
        <canvas id="barChart"></canvas>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="pb-chart-card h-100">
        <p class="pb-chart-title">Donations by Fund — <%= currentYear %></p>
        <canvas id="pieChart"></canvas>
      </div>
    </div>
  </div>

  <!-- ── Section 4: Recent Activity ── -->
  <p class="pb-dash-section">Recent Activity</p>
  <div class="row g-4 mb-4">

    <div class="col-lg-6">
      <div class="pb-table-card">
        <div class="pb-admin-section-header d-flex justify-content-between align-items-center">
          <span>Recent Transactions</span>
          <a href="/yearly-transactions/<%= currentYear %>/1" class="pb-view-all-link">View All →</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Paid In</th>
                <th>Paid Out</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentTransactions.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted py-3">No transactions found</td></tr>
              <% } else { %>
                <% for (const tx of recentTransactions) { %>
                  <tr>
                    <td><%= tx.date ? new Date(tx.date).toLocaleDateString('en-GB') : '' %></td>
                    <td class="text-truncate pb-truncate-col" title="<%= tx.description %>"><%= tx.description || '—' %></td>
                    <td class="<%= parseFloat(tx.paid_in) > 0 ? 'pb-amt-in' : 'text-muted' %>">
                      <%= parseFloat(tx.paid_in) > 0 ? '£' + parseFloat(tx.paid_in).toFixed(2) : '—' %>
                    </td>
                    <td class="<%= parseFloat(tx.paid_out) > 0 ? 'pb-amt-out' : 'text-muted' %>">
                      <%= parseFloat(tx.paid_out) > 0 ? '£' + parseFloat(tx.paid_out).toFixed(2) : '—' %>
                    </td>
                  </tr>
                <% } %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="pb-table-card">
        <div class="pb-admin-section-header d-flex justify-content-between align-items-center">
          <span>Recent Donations</span>
          <a href="/all-donations/1" class="pb-view-all-link">View All</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Donor</th>
                <th>Fund</th>
                <th>Amount</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentDonations.length === 0) { %>
                <tr><td colspan="4" class="text-center text-muted py-3">No donations found</td></tr>
              <% } else { %>
                <% for (const d of recentDonations) { %>
                  <tr>
                    <td><%= d.date ? new Date(d.date).toLocaleDateString('en-GB') : '' %></td>
                    <td><%= d.first_name %> <%= d.surname %></td>
                    <td><%= d.fund || '—' %></td>
                    <td class="pb-amt-in">£<%= parseFloat(d.amount).toFixed(2) %></td>
                  </tr>
                <% } %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- ── Section 5: Top Donors ── -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="pb-table-card">
        <div class="pb-admin-section-header d-flex justify-content-between align-items-center">
          <span>Top Donors — <%= currentYear %></span>
          <a href="/all-donations/1" class="pb-view-all-link">View All</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>#</th>
                <th>Name</th>
                <th>Total Given</th>
              </tr>
            </thead>
            <tbody>
              <% if (topDonors.length === 0) { %>
                <tr><td colspan="3" class="text-center text-muted py-3">No donation data</td></tr>
              <% } else { %>
                <% topDonors.forEach(function(donor, i) { %>
                  <tr>
                    <td><span class="pb-rank-badge"><%= i + 1 %></span></td>
                    <td><%= donor.first_name %> <%= donor.surname %></td>
                    <td class="pb-amt-in fw-semibold">£<%= parseFloat(donor.total).toFixed(2) %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Section 6: Quick Actions ── -->
  <p class="pb-dash-section">Quick Actions</p>
  <div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-primary" href="/select-giver">
      <i class="bi bi-plus-circle" aria-hidden="true"></i> Add Donation
    </a>
    <a class="btn btn-outline-secondary" href="/all-donations/1">
      <i class="bi bi-list-ul" aria-hidden="true"></i> All Donations
    </a>
    <a class="btn btn-outline-secondary" href="/claimants/1">
      <i class="bi bi-people" aria-hidden="true"></i> Members
    </a>
    <a class="btn btn-outline-secondary" href="/admin">
      <i class="bi bi-gear" aria-hidden="true"></i> Admin Console
    </a>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const barData = <%- barChartData %>;
  const pieData = <%- pieChartData %>;

  // Bar chart — Paid In vs Paid Out
  new Chart(document.getElementById('barChart').getContext('2d'), {
    type: 'bar',
    data: {
      labels: barData.map(r => r.month),
      datasets: [
        {
          label: 'Paid In',
          data: barData.map(r => r.paidIn),
          backgroundColor: 'rgba(47, 158, 68, 0.8)',
          borderColor: 'rgba(47, 158, 68, 1)',
          borderWidth: 1,
          borderRadius: 3
        },
        {
          label: 'Paid Out',
          data: barData.map(r => r.paidOut),
          backgroundColor: 'rgba(201, 42, 42, 0.7)',
          borderColor: 'rgba(201, 42, 42, 1)',
          borderWidth: 1,
          borderRadius: 3
        }
      ]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { position: 'top' },
        tooltip: {
          callbacks: {
            label: ctx => ' £' + ctx.parsed.y.toLocaleString('en-GB', { minimumFractionDigits: 2 })
          }
        }
      },
      scales: {
        x: { ticks: { maxRotation: 45, minRotation: 45 } },
        y: {
          beginAtZero: true,
          ticks: { callback: v => '£' + v.toLocaleString('en-GB') }
        }
      }
    }
  });

  // Doughnut chart — Donations by Fund
  const totalDonations = pieData.reduce((sum, r) => sum + r.total, 0);
  new Chart(document.getElementById('pieChart').getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: pieData.map(r => r.fund || 'Unspecified'),
      datasets: [{
        data: pieData.map(r => r.total),
        backgroundColor: [
          '#36A2EB', '#4BC0C0', '#2f9e44', '#FFCE56', '#9966FF',
          '#FF6384', '#F67019', '#00A36C', '#8B0000', '#808080'
        ],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      cutout: '62%',
      plugins: {
        legend: { position: 'right' },
        tooltip: {
          callbacks: {
            label: ctx => ' £' + ctx.parsed.toLocaleString('en-GB', { minimumFractionDigits: 2 })
          }
        }
      }
    },
    plugins: [{
      id: 'centerText',
      beforeDraw(chart) {
        const { width, height, ctx } = chart;
        ctx.save();
        ctx.font = 'bold 13px Inter, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#212529';
        ctx.fillText('£' + totalDonations.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }), width / 2, height / 2);
        ctx.restore();
      }
    }]
  });
</script>

<%- include("_loggedInFooter") -%>
