<%- include("_publicHeader") -%>

<div class="pb-update">

  <% if (success) { %>
    <div class="pb-update-card">
      <div class="alert alert-success mb-0" role="alert">
        <h4 class="alert-heading"><i class="bi bi-check-circle me-2"></i>Thank you!</h4>
        <p class="mb-0">
          Your details have been updated<% if (charityName) { %> and shared with <strong><%= charityName %></strong><% } %>.
          You can now close this page.
        </p>
      </div>
    </div>
  <% } else if (reason === 'invalid') { %>
    <div class="pb-update-card">
      <div class="alert alert-danger mb-0" role="alert">
        <h4 class="alert-heading">Invalid link</h4>
        <p class="mb-0">This update link is not valid. If you believe this is a mistake, please contact your church.</p>
      </div>
    </div>
  <% } else if (reason === 'used') { %>
    <div class="pb-update-card">
      <div class="alert alert-warning mb-0" role="alert">
        <h4 class="alert-heading">Link already used</h4>
        <p class="mb-0">This update link has already been used. If you need to make further changes, please ask your church to send you a new link.</p>
      </div>
    </div>
  <% } else if (reason === 'expired') { %>
    <div class="pb-update-card">
      <div class="alert alert-warning mb-0" role="alert">
        <h4 class="alert-heading">Link expired</h4>
        <p class="mb-0">This update link has expired. Please ask your church to send you a new one.</p>
      </div>
    </div>
  <% } else if (reason === 'error') { %>
    <div class="pb-update-card">
      <div class="alert alert-danger mb-0" role="alert">
        <h4 class="alert-heading">Something went wrong</h4>
        <p class="mb-0">We could not save your changes. Please try again in a moment.</p>
      </div>
    </div>
  <% } %>

  <% if (token && member) { %>
    <!-- Hero header — charity request -->
    <header class="pb-update-hero">
      <div class="pb-update-hero-icon <%= charityLogo ? 'pb-update-hero-icon--logo' : '' %>">
        <% if (charityLogo) { %>
          <img src="<%= charityLogo %>" alt="<%= charityName || 'Charity logo' %>">
        <% } else { %>
          <i class="bi bi-buildings"></i>
        <% } %>
      </div>
      <div>
        <h1 class="pb-update-title">Update Your Details</h1>
        <% if (charityName) { %>
          <p class="pb-update-subtitle">Requested by <strong><%= charityName %></strong></p>
        <% } %>
      </div>
    </header>

    <!-- Instructions -->
    <div class="pb-update-info">
      <i class="bi bi-info-circle me-2"></i>
      Please check your details below and update anything that is incorrect. Once you've saved, this link cannot be used again.
    </div>

    <form action="/update-details/<%= token %>" method="post" class="pb-update-form">

      <!-- Personal -->
      <section class="pb-update-card">
        <h2 class="pb-update-card-title">Personal</h2>
        <div class="pb-update-card-grid">

          <div class="pb-update-field">
            <label class="form-label" for="title">Title</label>
            <% const titles = ['Mr', 'Mrs', 'Miss', 'Ms', 'Dr', 'Rev']; %>
            <select class="form-select form-select-lg" name="title" id="title">
              <option value=""></option>
              <% titles.forEach(t => { %>
                <option value="<%= t %>" <%= member.title === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>

          <div class="pb-update-field">
            <label class="form-label" for="first_name">First Name</label>
            <input type="text" class="form-control form-control-lg" name="first_name" id="first_name" value="<%= member.first_name || '' %>" required>
          </div>

          <div class="pb-update-field pb-update-field--full">
            <label class="form-label" for="surname">Surname</label>
            <input type="text" class="form-control form-control-lg" name="surname" id="surname" value="<%= member.surname || '' %>" required>
          </div>

          <div class="pb-update-field">
            <label class="form-label" for="sex">Sex</label>
            <select class="form-select form-select-lg" name="sex" id="sex">
              <option value=""></option>
              <option value="MALE"   <%= member.sex === 'MALE'   ? 'selected' : '' %>>Male</option>
              <option value="FEMALE" <%= member.sex === 'FEMALE' ? 'selected' : '' %>>Female</option>
            </select>
          </div>

          <div class="pb-update-field">
            <label class="form-label" for="date_of_birth">Date of Birth</label>
            <input type="date" class="form-control form-control-lg" name="date_of_birth" id="date_of_birth"
              value="<%= member.date_of_birth ? new Date(member.date_of_birth).toISOString().slice(0,10) : '' %>">
          </div>

          <div class="pb-update-field pb-update-field--full">
            <label class="form-label" for="spouse_name">Name of Spouse</label>
            <input type="text" class="form-control form-control-lg" name="spouse_name" id="spouse_name" value="<%= member.spouse_name || '' %>" placeholder="Enter spouse's name">
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="pb-update-card">
        <h2 class="pb-update-card-title">Contact</h2>
        <div class="pb-update-card-grid">

          <div class="pb-update-field">
            <label class="form-label" for="email">Email</label>
            <input type="email" class="form-control form-control-lg" name="email" id="email" value="<%= member.email || '' %>">
          </div>

          <div class="pb-update-field">
            <label class="form-label" for="phone_number">Phone</label>
            <input type="tel" class="form-control form-control-lg" name="phone_number" id="phone_number" value="<%= member.phone_number || '' %>">
          </div>
        </div>
      </section>

      <!-- Address -->
      <section class="pb-update-card">
        <h2 class="pb-update-card-title">Address</h2>
        <div class="pb-update-card-grid">

          <div class="pb-update-field">
            <label class="form-label" for="house_number">House No.</label>
            <input type="text" class="form-control form-control-lg" name="house_number" id="house_number" value="<%= member.house_number || '' %>">
          </div>

          <div class="pb-update-field">
            <label class="form-label" for="postcode">Postcode</label>
            <input type="text" class="form-control form-control-lg" name="postcode" id="postcode" value="<%= member.postcode || '' %>">
          </div>

          <div class="pb-update-field pb-update-field--full">
            <label class="form-label" for="address_line_1">Address Line 1</label>
            <input type="text" class="form-control form-control-lg" name="address_line_1" id="address_line_1" value="<%= member.address_line_1 || '' %>">
          </div>

          <div class="pb-update-field pb-update-field--full">
            <label class="form-label" for="address_line_2">Address Line 2</label>
            <input type="text" class="form-control form-control-lg" name="address_line_2" id="address_line_2" value="<%= member.address_line_2 || '' %>">
          </div>

          <div class="pb-update-field pb-update-field--full">
            <label class="form-label" for="city">City</label>
            <input type="text" class="form-control form-control-lg" name="city" id="city" value="<%= member.city || '' %>">
          </div>
        </div>
      </section>

      <button type="submit" class="btn btn-primary btn-lg pb-update-submit">
        <i class="bi bi-check-lg me-2"></i>Save My Details
      </button>

      <p class="pb-update-fineprint">
        <i class="bi bi-shield-lock me-1"></i>
        Your information is stored securely and only shared with <strong><%= charityName || 'your church' %></strong>.
      </p>

    </form>
  <% } %>

</div>

<%- include("_footer") -%>
