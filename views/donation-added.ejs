<%- include("_loggedInHeader") -%>

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh; text-align: center;">
  <div class="mb-3">
    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
  </div>
  <h2 class="pb-page-title mb-2">Donation Added</h2>
  <p class="text-muted mb-4">The donation was recorded successfully. This tab will close automatically.</p>
  <button class="btn btn-outline-secondary btn-sm" onclick="window.close()">Close Tab</button>
</div>

<% if (autoclose) { %>
<script>
  window.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () { window.close(); }, 3000);
  });
</script>
<% } %>

<%- include("_loggedInFooter") -%>
