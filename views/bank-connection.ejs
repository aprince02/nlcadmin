<%- include("_loggedInHeader") -%>

<div class="pb-page">
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Bank Connection</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/admin">Admin Console</a></li>
          <li class="breadcrumb-item active" aria-current="page">Bank Connection</li>
        </ol>
      </nav>
    </div>
    <% if (connection) { %>
    <div class="pb-page-actions d-print-none">
      <form action="/bank/sync" method="post" class="d-inline">
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync Now
        </button>
      </form>
      <form action="/bank/disconnect" method="post" class="d-inline"
            onsubmit="return confirm('Disconnect this bank account? You can reconnect at any time.')">
        <button type="submit" class="btn btn-outline-danger btn-sm">
          <i class="bi bi-x-circle" aria-hidden="true"></i> Disconnect
        </button>
      </form>
    </div>
    <% } %>
  </div>

  <% if (consentWarning) { %>
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill"></i>
      <span>
        <strong>Consent expiring soon.</strong>
        Your Open Banking consent expires on
        <strong><%= new Date(connection.consent_expires_at).toLocaleDateString('en-GB') %></strong>.
        <a href="/bank/connect">Reconnect now</a> to avoid interruption.
      </span>
    </div>
  <% } %>

  <!-- Connection Status -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="pb-table-card">
        <div class="pb-admin-section-header">Connection Status</div>
        <div class="p-4">
          <% if (connection) { %>
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="pb-bank-status-dot pb-bank-status-dot--connected"></span>
              <span class="fw-semibold text-success">Connected</span>
            </div>
            <table class="table table-sm mb-0">
              <tbody>
                <tr>
                  <td class="text-muted" style="width:40%">Account</td>
                  <td class="fw-semibold"><%= connection.account_name %></td>
                </tr>
                <tr>
                  <td class="text-muted">Type</td>
                  <td><%= connection.account_type || '—' %></td>
                </tr>
                <tr>
                  <td class="text-muted">Sort Code</td>
                  <td><%= connection.sort_code || '—' %></td>
                </tr>
                <tr>
                  <td class="text-muted">Account No.</td>
                  <td><%= connection.account_number ? '****' + connection.account_number.slice(-4) : '—' %></td>
                </tr>
                <tr>
                  <td class="text-muted">Provider</td>
                  <td><%= connection.provider_id?.toUpperCase() || 'HSBC' %></td>
                </tr>
                <tr>
                  <td class="text-muted">Last Synced</td>
                  <td>
                    <% if (connection.last_synced_at) { %>
                      <%= new Date(connection.last_synced_at).toLocaleString('en-GB') %>
                    <% } else { %>
                      Never
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <td class="text-muted">Consent Expires</td>
                  <td class="<%= consentWarning ? 'text-warning fw-semibold' : '' %>">
                    <%= new Date(connection.consent_expires_at).toLocaleDateString('en-GB') %>
                  </td>
                </tr>
              </tbody>
            </table>
          <% } else { %>
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="pb-bank-status-dot pb-bank-status-dot--disconnected"></span>
              <span class="fw-semibold text-muted">Not Connected</span>
            </div>
            <p class="text-muted mb-4" style="font-size: var(--font-sm);">
              Connect your HSBC account via Open Banking to automatically sync
              balances and transactions every 6 hours.
              Your CSV import remains available as a fallback at any time.
            </p>
            <a class="btn btn-primary" href="/bank/connect">
              <i class="bi bi-bank" aria-hidden="true"></i> Connect HSBC Account
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Live Balance -->
    <div class="col-lg-6">
      <div class="pb-table-card h-100">
        <div class="pb-admin-section-header">Live Balance</div>
        <div class="p-4">
          <% if (balance) { %>
            <p class="pb-kpi-label mb-1">Current Balance</p>
            <p class="pb-kpi-value mb-1">
              £<%= parseFloat(balance.current).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %>
            </p>
            <% if (balance.available !== null && balance.available !== undefined) { %>
              <p class="text-muted mb-3" style="font-size: var(--font-sm);">
                Available: £<%= parseFloat(balance.available).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %>
              </p>
            <% } %>
            <p class="text-muted" style="font-size: var(--font-xs);">
              <i class="bi bi-clock"></i>
              Last updated: <%= new Date(balance.recorded_at).toLocaleString('en-GB') %>
            </p>
          <% } else { %>
            <p class="text-muted" style="font-size: var(--font-sm);">
              No balance data yet.
              <% if (connection) { %>
                <a href="#" onclick="document.querySelector('[action=\'/bank/sync\']').submit()">Run a sync</a> to fetch it.
              <% } %>
            </p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Bank Transactions -->
  <% if (recentTxns.length > 0) { %>
  <div class="pb-table-card mb-4">
    <div class="pb-admin-section-header">Recent Bank Transactions (from Open Banking)</div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Merchant</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% for (const tx of recentTxns) { %>
            <tr>
              <td><%= tx.date ? new Date(tx.date).toLocaleDateString('en-GB') : '' %></td>
              <td class="text-truncate pb-truncate-col" title="<%= tx.description %>"><%= tx.description || '—' %></td>
              <td><%= tx.merchant_name || '—' %></td>
              <td>
                <span class="badge <%= tx.transaction_type === 'CREDIT' ? 'bg-success' : 'bg-danger' %> bg-opacity-75">
                  <%= tx.transaction_type || '—' %>
                </span>
              </td>
              <td class="<%= tx.amount > 0 ? 'pb-amt-in' : 'pb-amt-out' %> fw-semibold">
                <%= tx.amount > 0 ? '+' : '' %>£<%= Math.abs(tx.amount).toFixed(2) %>
              </td>
              <td>
                <span class="badge bg-<%= tx.status === 'posted' ? 'secondary' : 'warning' %> bg-opacity-75">
                  <%= tx.status %>
                </span>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Sync Log -->
  <div class="pb-table-card mb-4">
    <div class="pb-admin-section-header">Sync Log</div>
    <% if (syncLogs.length === 0) { %>
      <p class="text-muted p-4 mb-0" style="font-size: var(--font-sm);">No sync history yet.</p>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Time</th>
            <th>Type</th>
            <th>Status</th>
            <th>Fetched</th>
            <th>Inserted</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          <% for (const entry of syncLogs) { %>
            <tr>
              <td style="white-space:nowrap"><%= new Date(entry.synced_at).toLocaleString('en-GB') %></td>
              <td><%= entry.sync_type %></td>
              <td>
                <span class="badge bg-<%= entry.status === 'success' ? 'success' : entry.status === 'consent_expired' ? 'warning' : 'danger' %> bg-opacity-75">
                  <%= entry.status %>
                </span>
              </td>
              <td><%= entry.records_fetched %></td>
              <td><%= entry.records_inserted %></td>
              <td class="text-danger" style="font-size: var(--font-xs)"><%= entry.error_message || '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <!-- Fallback note -->
  <div class="alert alert-info d-flex gap-2 align-items-start" role="note">
    <i class="bi bi-info-circle-fill mt-1"></i>
    <div style="font-size: var(--font-sm);">
      <strong>CSV import remains available.</strong>
      If the bank connection is unavailable, you can still upload a CSV export from HSBC
      via the <a href="/admin">Admin Console</a>.
      Open Banking data is stored separately and does not overwrite your manual records.
    </div>
  </div>

</div>

<%- include("_loggedInFooter") -%>
