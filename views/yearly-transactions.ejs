<%- include("_loggedInHeader") -%>

<div class="pb-page">
  <div class="pb-page-header">
    <div>
      <h1 class="pb-page-title">Bank Transactions</h1>
      <p class="pb-page-subtitle"><%= year %></p>
    </div>
  </div>

  <!-- Toast notification (shown after modal donation saved) -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="donationToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="bi bi-check-circle-fill me-2"></i>Donation saved successfully.
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>

  <div class="pb-table-card">
    <div class="table-responsive-sm">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Paid Out</th>
            <th>Paid In</th>
            <th>Type</th>
            <th class="d-print-none">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (const each of row) { %>
            <tr id="tx-row-<%= each.id %>">
              <form action="/save-transaction/<%= each.id %>" method="post">
                <td>
                  <input type="hidden" name="date" value="<%= each.date ? new Date(each.date).toISOString().split('T')[0] : '' %>" />
                  <input readonly type="text" class="form-control pb-input-year"
                    value="<%= each.date ? new Date(each.date).toLocaleDateString('en-GB') : '' %>" />
                </td>
                <td>
                  <input type="text" class="form-control pb-field-lg" name="description" value="<%= each.description %>" readonly>
                </td>
                <td>
                  <input readonly type="text" class="form-control pb-input-sm" name="paid_out" value="<%= each.paid_out %>"/>
                </td>
                <td>
                  <input readonly type="text" class="form-control pb-input-sm" name="paid_in" value="<%= each.paid_in %>"/>
                </td>
                <td>
                  <select required class="form-select pb-field-natural" name="type">
                    <option value="" <%= !each.type ? 'selected' : '' %>></option>
                    <% types.forEach(typeObj => { %>
                      <option value="<%= typeObj.type %>" <%= each.type === typeObj.type ? 'selected' : '' %>><%= typeObj.type %></option>
                    <% }); %>
                  </select>
                </td>
                <td class="d-print-none" style="white-space:nowrap">
                  <button type="button" class="btn btn-sm btn-info add-donation-btn"
                    data-tx-id="<%= each.id %>"
                    data-date="<%= each.date ? new Date(each.date).toISOString().slice(0,10) : '' %>"
                    data-description="<%= (each.description || '').replace(/"/g, '&quot;') %>"
                    data-paid-in="<%= each.paid_in || '' %>">
                    <i class="bi bi-plus-circle me-1"></i>Add Donation
                  </button>
                  <input type="submit" value="Save" class="btn btn-sm btn-success" />
                </td>
              </form>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">
      <% if (totalPages > 1) { %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="/yearly-transactions/<%= year %>/<%= i %>"><%= i %></a>
          </li>
        <% } %>
      <% } %>
    </ul>
  </nav>
</div>

<!-- ── Add Donation Modal ──────────────────────────────────────── -->
<div class="modal fade" id="addDonationModal" tabindex="-1" aria-labelledby="addDonationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <!-- Header -->
      <div class="modal-header pb-modal-header">
        <div>
          <h5 class="modal-title mb-0" id="addDonationModalLabel">
            <i class="bi bi-wallet2 me-2"></i>Add Donation
          </h5>
          <small class="text-muted" id="modalTxContext"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body">

        <!-- Transaction context card -->
        <div class="card mb-4" id="txContextCard" style="background:#f8f9ff; border:1px solid #dee2ff;">
          <div class="card-body py-2 px-3">
            <div class="row g-2 align-items-center">
              <div class="col-auto">
                <span class="badge text-bg-secondary">Transaction</span>
              </div>
              <div class="col">
                <span id="ctxDescription" class="fw-semibold text-truncate d-inline-block" style="max-width:320px"></span>
              </div>
              <div class="col-auto text-end">
                <span class="text-muted small me-2" id="ctxDate"></span>
                <span class="fw-bold text-success" id="ctxAmount"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Donor search -->
        <div class="mb-3">
          <label class="form-label fw-semibold">
            <i class="bi bi-search me-1"></i>Search Donor
          </label>
          <div class="position-relative">
            <input type="text" id="donorSearch" class="form-control" placeholder="Type a name to search…" autocomplete="off">
            <div id="donorResults" class="list-group position-absolute w-100 shadow" style="z-index:200; top:100%; display:none; max-height:220px; overflow-y:auto;"></div>
          </div>
          <div id="selectedDonorBadge" class="mt-2" style="display:none">
            <span class="badge text-bg-primary fs-6 px-3 py-2">
              <i class="bi bi-person-check me-1"></i>
              <span id="selectedDonorName"></span>
              <button type="button" class="btn-close btn-close-white ms-2" id="clearDonor" style="font-size:.6rem" aria-label="Clear"></button>
            </span>
          </div>
        </div>

        <hr class="my-3">

        <!-- Donation form -->
        <form id="donationModalForm" novalidate>
          <input type="hidden" id="modal_member_id" name="member_id">

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label class="form-label" for="modal_first_name">First Name</label>
              <input class="form-control" name="first_name" id="modal_first_name" required>
              <div class="invalid-feedback">First name is required.</div>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="modal_surname">Surname</label>
              <input class="form-control" name="surname" id="modal_surname" required>
              <div class="invalid-feedback">Surname is required.</div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-sm-4">
              <label class="form-label" for="modal_amount">Amount (£)</label>
              <input type="number" step="0.01" min="0" class="form-control" name="amount" id="modal_amount" required>
              <div class="invalid-feedback">Please enter an amount.</div>
            </div>
            <div class="col-sm-4">
              <label class="form-label" for="modal_date">Date</label>
              <input type="date" class="form-control" name="date" id="modal_date" required>
              <div class="invalid-feedback">Please select a date.</div>
            </div>
            <div class="col-sm-4">
              <label class="form-label" for="modal_gift_aid">Gift Aid Status</label>
              <select class="form-select" name="gift_aid_status" id="modal_gift_aid">
                <option value="Unclaimed" selected>Unclaimed</option>
                <option value="Claimed">Claimed</option>
                <option value="N/A">N/A</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="modal_fund">Fund</label>
            <select required class="form-select" name="fund" id="modal_fund">
              <option value="">— Select fund —</option>
              <% donationTypes.forEach(type => { %>
                <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
            <div class="invalid-feedback">Please select a fund.</div>
            <div id="fundSuggestionHint" class="d-none mt-1">
              <small class="text-primary">
                <i class="bi bi-magic me-1"></i>Suggested from transaction description
              </small>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="modal_notes">Notes</label>
            <input class="form-control" name="notes" id="modal_notes" placeholder="Optional notes…">
          </div>

          <!-- Error area -->
          <div id="modalError" class="alert alert-danger d-none" role="alert"></div>
        </form>

      </div><!-- /modal-body -->

      <!-- Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="submitDonationBtn">
          <span id="submitBtnSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
          <i class="bi bi-check-lg me-1" id="submitBtnIcon"></i>Save Donation
        </button>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // ── Fund suggestion: fuzzy matching against donation_types ────────

  /**
   * Alias/synonym map.
   * Keys must match donation type names exactly as stored in donation_types.
   * Values are keyword patterns used for fuzzy matching only.
   * If a key doesn't exist in the live donationTypes list it is ignored.
   */
  const FUND_ALIASES = {
    'Tithe':                 ['tithe', 'tith', 'tight', 'tenth', 'tiths'],
    'Offering':              ['offering', 'offerin', 'offer', 'collection'],
    'Sunday School Offering':['sunday school', 'sundayschool', 'sunday offering'],
    'Vehicle':               ['van', 'vangift', 'vehicle', 'transport', 'car', 'bus'],
    'Building Rent':         ['rent', 'hallrent', 'hall rent', 'hall', 'building rent', 'parochial', 'church rent'],
    'Audio/Visual/Licenses': ['zoom', 'license', 'licence', 'audio visual', 'audiovisual', 'software', 'streaming', 'media'],
    'Food':                  ['food', 'catering', 'snack', 'snacks', 'meal', 'restaurant', 'grocery'],
    'Gift Aid Claim':        ['hmrc', 'gift aid', 'giftaid', 'charities', 'hmrc charities'],
    'Bank Charges':          ['charges', 'bank charge', 'total charges', 'fee', 'bank fee'],
  };

  /** Normalise a string: lowercase, strip punctuation, collapse spaces. */
  function normalise(str) {
    return (str || '')
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  /** Classic Levenshtein distance between two strings. */
  function levenshtein(a, b) {
    const m = a.length, n = b.length;
    if (!m) return n;
    if (!n) return m;
    const dp = [];
    for (let i = 0; i <= m; i++) { dp[i] = [i]; }
    for (let j = 0; j <= n; j++) { dp[0][j] = j; }
    for (let i = 1; i <= m; i++) {
      for (let j = 1; j <= n; j++) {
        dp[i][j] = a[i - 1] === b[j - 1]
          ? dp[i - 1][j - 1]
          : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
      }
    }
    return dp[m][n];
  }

  /**
   * Score one keyword against a normalised description.
   * Returns a confidence value 0–1.
   *
   * Strategy:
   *  1. Exact substring → 1.0
   *  2. Normalised description starts with / ends with keyword → 0.85
   *  3. Per-token Levenshtein similarity above 0.75 → proportional score
   */
  function scoreKeyword(keyword, normDesc) {
    if (!keyword || !normDesc) return 0;

    // 1. Exact substring
    if (normDesc.includes(keyword)) return 1.0;

    // 2. Normalised keyword is a prefix/suffix of a token
    const tokens = normDesc.split(' ');
    for (const token of tokens) {
      if (token.length < 3) continue;
      if (token.startsWith(keyword) || keyword.startsWith(token)) return 0.85;
    }

    // 3. Per-token Levenshtein — only bother for keywords ≥ 4 chars
    if (keyword.length < 4) return 0;
    let best = 0;
    for (const token of tokens) {
      if (token.length < 3) continue;
      const maxLen = Math.max(keyword.length, token.length);
      const sim = 1 - levenshtein(keyword, token) / maxLen;
      if (sim > best) best = sim;
    }
    // Dampen Levenshtein scores slightly so exact matches win clearly
    return best * 0.9;
  }

  /**
   * Main matching function.
   * @param {string}   description  - Raw transaction description
   * @param {string[]} donationTypes - Live list from donation_types table
   * @returns {{ type: string, score: number } | null}
   */
  function matchSuggestedDonationType(description, donationTypes) {
    const CONFIDENCE_THRESHOLD = 0.60;
    const normDesc = normalise(description);
    if (!normDesc) return null;

    let bestType  = null;
    let bestScore = 0;

    for (const type of donationTypes) {
      // Build the keyword list for this type:
      // defined aliases first, then fall back to the normalised type name itself
      const aliases = (FUND_ALIASES[type] || []).concat(normalise(type));

      let typeScore = 0;
      for (const alias of aliases) {
        const s = scoreKeyword(normalise(alias), normDesc);
        if (s > typeScore) typeScore = s;
      }

      if (typeScore > bestScore) {
        bestScore = typeScore;
        bestType  = type;
      }
    }

    return bestScore >= CONFIDENCE_THRESHOLD ? { type: bestType, score: bestScore } : null;
  }

  // ── State ────────────────────────────────────────────────────────
  let selectedMemberId = null;
  let searchTimer = null;
  let duplicateConfirmPending = false;

  const modal        = document.getElementById('addDonationModal');
  const bsModal      = new bootstrap.Modal(modal);
  const searchInput  = document.getElementById('donorSearch');
  const resultsBox   = document.getElementById('donorResults');
  const badgeBox     = document.getElementById('selectedDonorBadge');
  const badgeName    = document.getElementById('selectedDonorName');
  const clearBtn     = document.getElementById('clearDonor');
  const form         = document.getElementById('donationModalForm');
  const submitBtn    = document.getElementById('submitDonationBtn');
  const spinner      = document.getElementById('submitBtnSpinner');
  const submitIcon   = document.getElementById('submitBtnIcon');
  const errorBox     = document.getElementById('modalError');

  // ── Open modal when "Add Donation" button clicked ────────────────
  document.querySelectorAll('.add-donation-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      const txId        = this.dataset.txId;
      const date        = this.dataset.date;        // YYYY-MM-DD
      const description = this.dataset.description;
      const paidIn      = this.dataset.paidIn;

      // Reset state
      selectedMemberId = null;
      duplicateConfirmPending = false;
      form.reset();
      form.classList.remove('was-validated');
      errorBox.classList.add('d-none');
      submitBtn.textContent = '';
      submitBtn.innerHTML = '<span id="submitBtnSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span><i class="bi bi-check-lg me-1" id="submitBtnIcon"></i>Save Donation';
      submitBtn.classList.remove('btn-warning');
      submitBtn.classList.add('btn-success');
      searchInput.value = '';
      resultsBox.style.display = 'none';
      badgeBox.style.display = 'none';

      // Store tx id on form for reference
      form.dataset.txId = txId;

      // Fill context card
      document.getElementById('ctxDescription').textContent = description || '—';
      document.getElementById('ctxDate').textContent = date
        ? new Date(date + 'T00:00:00').toLocaleDateString('en-GB') : '';
      document.getElementById('ctxAmount').textContent = paidIn ? '£' + parseFloat(paidIn).toFixed(2) : '';

      // Prefill form fields
      document.getElementById('modal_date').value   = date || '';
      document.getElementById('modal_amount').value = paidIn ? parseFloat(paidIn).toFixed(2) : '';
      document.getElementById('modal_notes').value  = '';

      // Fuzzy-match fund from description against live donation types
      const fundSelect    = document.getElementById('modal_fund');
      const fundHint      = document.getElementById('fundSuggestionHint');
      const availableTypes = Array.from(fundSelect.options)
        .map(o => o.value).filter(Boolean);

      const suggestion = matchSuggestedDonationType(description, availableTypes);
      if (suggestion) {
        fundSelect.value = suggestion.type;
        fundHint.classList.remove('d-none');
      } else {
        fundSelect.value = '';
        fundHint.classList.add('d-none');
      }

      // Hide hint when user manually picks a different fund
      fundSelect.addEventListener('change', () => fundHint.classList.add('d-none'), { once: true });

      bsModal.show();
      setTimeout(() => searchInput.focus(), 300);
    });
  });

  // ── Donor search (debounced) ─────────────────────────────────────
  searchInput.addEventListener('input', function () {
    clearTimeout(searchTimer);
    const q = this.value.trim();
    if (!q) { resultsBox.style.display = 'none'; return; }
    searchTimer = setTimeout(() => fetchDonors(q), 250);
  });

  async function fetchDonors(q) {
    try {
      const res = await fetch('/api/members/search?q=' + encodeURIComponent(q));
      const members = await res.json();
      renderResults(members);
    } catch {
      resultsBox.style.display = 'none';
    }
  }

  function renderResults(members) {
    resultsBox.innerHTML = '';
    if (!members.length) {
      resultsBox.innerHTML = '<div class="list-group-item text-muted small py-2">No donors found</div>';
      resultsBox.style.display = 'block';
      return;
    }
    members.forEach(m => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'list-group-item list-group-item-action py-2';
      item.innerHTML =
        `<span class="fw-semibold">${m.first_name} ${m.surname}</span>` +
        (m.banking_name ? `<small class="text-muted ms-2">${m.banking_name}</small>` : '');
      item.addEventListener('click', () => selectDonor(m));
      resultsBox.appendChild(item);
    });
    resultsBox.style.display = 'block';
  }

  function selectDonor(m) {
    selectedMemberId = m.id;
    document.getElementById('modal_member_id').value  = m.id;
    document.getElementById('modal_first_name').value = m.first_name;
    document.getElementById('modal_surname').value    = m.surname;

    badgeName.textContent  = m.first_name + ' ' + m.surname;
    badgeBox.style.display = 'block';
    searchInput.value      = '';
    resultsBox.style.display = 'none';
  }

  clearBtn.addEventListener('click', () => {
    selectedMemberId = null;
    document.getElementById('modal_member_id').value  = '';
    document.getElementById('modal_first_name').value = '';
    document.getElementById('modal_surname').value    = '';
    badgeBox.style.display = 'none';
    searchInput.focus();
  });

  // Hide results when clicking outside
  document.addEventListener('click', e => {
    if (!searchInput.contains(e.target) && !resultsBox.contains(e.target)) {
      resultsBox.style.display = 'none';
    }
  });

  // ── Submit donation ───────────────────────────────────────────────
  submitBtn.addEventListener('click', async () => {
    form.classList.add('was-validated');
    if (!form.checkValidity()) return;

    const payload = {
      member_id:       document.getElementById('modal_member_id').value  || null,
      first_name:      document.getElementById('modal_first_name').value.trim(),
      surname:         document.getElementById('modal_surname').value.trim(),
      amount:          document.getElementById('modal_amount').value,
      date:            document.getElementById('modal_date').value,
      fund:            document.getElementById('modal_fund').value,
      notes:           document.getElementById('modal_notes').value.trim(),
      gift_aid_status: document.getElementById('modal_gift_aid').value,
      transaction_id:  form.dataset.txId || null,
      confirmed:       duplicateConfirmPending,
    };

    const spinnerEl = document.getElementById('submitBtnSpinner');
    const iconEl    = document.getElementById('submitBtnIcon');
    spinnerEl.classList.remove('d-none');
    iconEl.classList.add('d-none');
    submitBtn.disabled = true;
    errorBox.classList.add('d-none');

    try {
      const res = await fetch('/api/donations/modal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (data.duplicate) {
        // Show warning — next click will confirm and save anyway
        duplicateConfirmPending = true;
        errorBox.className = 'alert alert-warning';
        errorBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i>A donation already exists for this transaction. Click <strong>Save Donation</strong> again to save it anyway.';
        errorBox.classList.remove('d-none');
        submitBtn.classList.remove('btn-success');
        submitBtn.classList.add('btn-warning');
      } else if (data.success) {
        duplicateConfirmPending = false;
        bsModal.hide();
        const toast = new bootstrap.Toast(document.getElementById('donationToast'), { delay: 3500 });
        toast.show();
      } else {
        errorBox.className = 'alert alert-danger';
        errorBox.textContent = data.error || 'Failed to save donation.';
        errorBox.classList.remove('d-none');
      }
    } catch {
      errorBox.className = 'alert alert-danger';
      errorBox.textContent = 'Network error — please try again.';
      errorBox.classList.remove('d-none');
    } finally {
      spinnerEl.classList.add('d-none');
      iconEl.classList.remove('d-none');
      submitBtn.disabled = false;
    }
  });
});
</script>

<%- include("_loggedInFooter") -%>
