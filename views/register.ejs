<%- include("_authHeader") -%>

<main class="pb-auth-page">
  <div class="pb-auth-wrapper">

    <img src="/css/probooks.png" alt="ProBooks" class="pb-auth-brand-img">

    <div class="pb-auth-card">
      <h2 class="pb-auth-card-title">Create Account</h2>

      <form action="/register" method="post">
        <div class="pb-auth-field">
          <label class="pb-auth-label" for="username">USERNAME</label>
          <div class="pb-auth-input-wrap">
            <i class="bi bi-person pb-auth-input-icon"></i>
            <input required type="text" id="username" name="username" class="pb-auth-input" placeholder="Enter username">
          </div>
        </div>

        <div class="pb-auth-field">
          <label class="pb-auth-label" for="email">EMAIL ADDRESS</label>
          <div class="pb-auth-input-wrap">
            <i class="bi bi-envelope pb-auth-input-icon"></i>
            <input required type="email" id="email" name="email" class="pb-auth-input" placeholder="you@example.com">
          </div>
        </div>

        <div class="pb-auth-field">
          <label class="pb-auth-label" for="password">PASSWORD</label>
          <div class="pb-auth-input-wrap">
            <i class="bi bi-lock pb-auth-input-icon"></i>
            <input required id="password" name="password" type="password" class="pb-auth-input pb-auth-input-pwd" placeholder="••••••••" minlength="8">
            <button type="button" class="pb-auth-eye" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">
              <i class="bi bi-eye" id="eyeIcon"></i>
            </button>
          </div>
          <div style="font-size:0.7rem;color:var(--pb-gray-400);margin-top:0.3rem;">Must be at least 8 characters.</div>
        </div>

        <div class="pb-auth-field">
          <label class="pb-auth-label" for="security_question">NAME OF FIRST SCHOOL</label>
          <div class="pb-auth-input-wrap">
            <i class="bi bi-shield-check pb-auth-input-icon"></i>
            <input required type="text" id="security_question" name="security_question" class="pb-auth-input" placeholder="Security answer">
          </div>
        </div>

        <button type="submit" class="pb-auth-submit">Create Account &rarr;</button>
      </form>

      <hr class="pb-auth-divider">

      <div class="pb-auth-links pb-auth-links-center">
        <a href="/login">Already have an account? Sign in</a>
      </div>
    </div>

    <p class="pb-auth-footer-text">&copy; <%= new Date().getFullYear() %> ProBooks. Church Financial Administration.</p>

  </div>
</main>

<%- include("_authFooter") -%>
