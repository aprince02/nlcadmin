<%- include("_loggedInHeader") -%>

<nav aria-label="breadcrumb" class="mt-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/claimants/1">Members</a></li>
    <li class="breadcrumb-item active" aria-current="page">Delete Member</li>
  </ol>
</nav>

<h1 class="display-5">Delete Member?</h1>

<form action="/delete/<%= member.id %>" method="post">
  <div class="form-horizontal">

    <%- include("_displayClaimant") -%>

    <div class="form-group row mt-3">
      <label class="col-form-label col-sm-2"></label>
      <div class="col-sm-10">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a class="btn btn-outline-secondary" href="/claimants/1">Cancel</a>
      </div>
    </div>
  </div>
</form>

<%- include("_loggedInFooter") -%>